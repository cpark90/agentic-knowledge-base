load("@kb_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//defs:kb.bzl", "check_extracted_sources", "check_gates")
load("//defs:knowledge.bzl", "kb_gate_test", "kb_runner_env_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "validate.py",
    "canonicalize.py",
    "chunk_lint.py",
    "channel_lint.py",
    "chunk2kg.py",
    "doccheck.py",
    "gen_build.py",
    "extract.py",
    "stamp.py",
    "gen_skills.py",
    "gendoc.py",
    "weave.py",
    "extract_refs.py",
    "kb_lib.py",
    "vv_run.py",
    "vv_run_env_test.py",
    "requirements_lock.txt",
])

# 등록부 사이드카 — 한정 이름 → uuid 가 코드 청크의 정체성이다 (p10-function-identity-registry).
# //:extract_drift_* 가 파일마다 자기 등록부를 runfiles 로 읽는다.
exports_files(glob(["*.chunks.yml"]))

# EXTRACTED_SOURCES(//defs:kb.bzl, 단일 정의처)와 이 패키지의 등록부 사이드카 존재가 같은 집합인지 로드
# 시점에 강제한다(M1, 2026-10-01) — 글로벌 glob 은 패키지를 못 넘으므로 이 자리(tools 패키지)에서 돈다.
check_extracted_sources(glob(["*.chunks.yml"]))

# 게이트 등록부(`GATES`·`TOOL_TAGS`, //defs:kb.bzl 의 단일 정의처)의 자기 정합성을 로드 시점에 강제한다
# (M1, 2026-10-02) — 항목마다 네 키, 계층은 어휘 안, 두 목록은 서로소. `check_extracted_sources` 와 같은 자리다.
check_gates()

# 이 패키지의 소스 전부 — 문서 현행성 게이트(//:doccheck_test)가 문서의 `tools/…` 경로 실재를 runfiles 로 판정한다
filegroup(
    name = "tools",
    srcs = glob([
        "*.py",
        "*.sh",
        "*.in",
        "*.txt",
        "BUILD.bazel",
        "cq-queries/*.rq",
        "verify-queries/*.rq",
    ]),
)

filegroup(
    name = "verify_queries",
    srcs = glob(["verify-queries/*.rq"]),
)

# 역량 질문 질의 — 하나가 CQ 하나다 (docs/competency-questions.md)
filegroup(
    name = "cq_queries",
    srcs = glob(["cq-queries/*.rq"]),
)

# chunk2kg.py 를 함께 싣는 까닭: load_residency 가 PLANES·LEVELS 리터럴 읽기를 chunk2kg.load_plane_level_state 에서
# import 해 쓴다 — 리터럴 읽기 함수의 정의처를 하나로 모은 형태다(오케스트레이터 판정, 2026-09-27). 방향은 이쪽
# 뿐이다 — chunk2kg 는 rdflib 없이 타깃마다 돌아 kb_lib 를 반대로 import 하지 않는다.
py_library(
    name = "kb_lib",
    srcs = ["kb_lib.py", "chunk2kg.py"],
    # 게이트 등록부(`GATES`)의 단일 정의처 — kb_lib 이 적재 시점에 리터럴을 읽어 `*_GATE` 상수를 파생하므로
    # 이 모듈을 쓰는 모든 타깃의 runfiles 에 따라가야 한다. 없으면 적재 시점에 죽는다(의도된 음성 동작)
    data = ["//defs:kb.bzl"],
    deps = [requirement("rdflib")],
)

# 게이트 도구를 손으로 돌릴 때: bazel run //tools:validate -- --ontology <files...>
py_binary(
    name = "validate",
    srcs = ["validate.py"],
    args = ["--vocab=$(rootpath @tiktoken_o200k_base//file)"],
    data = ["@tiktoken_o200k_base//file"],  # 게이트 token-budget 이 어휘 지문을 고정값과 대조한다 (sha256 만 — tiktoken 은 필요 없다)
    deps = [
        ":kb_lib",
        requirement("owlrl"),
        requirement("pyshacl"),
        requirement("rdflib"),
    ],
)

# 청크 린트. chunk2kg.py 를 함께 실은 까닭은 논평 본문의 파서(comment_form)가 방출기와 같아야 하기 때문이다 —
# 게이트와 그래프가 다른 판정을 쓰면 `issue (blocking)` 의 게이트 효과가 방출과 갈린다 (p7-commentary-form)
py_binary(
    name = "chunk_lint",
    srcs = [
        "chunk2kg.py",
        "chunk_lint.py",
    ],
    args = ["--vocab=$(rootpath @tiktoken_o200k_base//file)"],
    data = ["@tiktoken_o200k_base//file"],  # 크기 판정의 단위가 토큰이다 (p1-chunk-unit-is-tokens)
    main = "chunk_lint.py",
    deps = [
        ":kb_lib",
        requirement("tiktoken"),
    ],
)

# 청크 파일(frontmatter) → head 그래프(-kg) 생성기. 한 청크는 한 파일 (4.3절, 4.9절)
# `agt:tokenCount` 를 방출하므로 계수기가 이 타깃의 입력이다 (p1-chunk-unit-is-tokens). rdflib 는 여기 없다 —
# 본문을 떼는 규칙과 계수기의 정의처를 이 모듈에 둔 까닭이 그것이다 (타깃마다 돌므로 적재 비용을 아낀다)
py_binary(
    name = "chunk2kg",
    srcs = ["chunk2kg.py"],
    args = ["--vocab=$(rootpath @tiktoken_o200k_base//file)"],
    data = ["@tiktoken_o200k_base//file"],
    deps = [requirement("tiktoken")],
)

# 설계 공간 청크(`-space`) → 설계 공간 그래프(*-space.ttl) 생성기 (결정 p9-candidate-storage). 변수 하나가 파일 하나다.
# 후보 링크는 여기서만 그래프가 된다 — kb_chunk 타깃을 만들지 않으므로 **후보는 결코 deps 가 되지 않는다**.
# frontmatter 파서와 링크 IRI 규칙(link_hash)은 chunk2kg 가 정의처다. PyYAML 은 본문 블록용(odd2kg 와 같은 잠금)
py_binary(
    name = "space2kg",
    srcs = [
        "chunk2kg.py",
        "space2kg.py",
    ],
    args = ["--vocab=$(rootpath @tiktoken_o200k_base//file)"],
    data = ["@tiktoken_o200k_base//file"],  # agt:Space 는 agt:Chunk 의 하위라 agt:tokenCount 를 갖는다
    main = "space2kg.py",
    deps = [
        ":kb_lib",
        requirement("pyyaml"),
        requirement("tiktoken"),
    ],
)

# 설계 공간의 체크박스 뷰 (p9-candidate-storage 13.5절): `[ ]` 열린 후보 · `[-]` 배제 + 근거 · `[x]` 확정.
# 뷰이고 게이트가 아니다 — 판정은 //kg:gate_test 의 check_space 가 한다 (게이트 id space)
py_binary(
    name = "choices",
    srcs = ["choices.py"],
    deps = [
        ":kb_lib",
        requirement("rdflib"),
    ],
)

# ODD 택소노미 뷰 (부록 E.4): related/condition → taxonomy.yml
py_binary(
    name = "taxonomy",
    srcs = ["taxonomy.py"],
    deps = [requirement("rdflib")],
)

# OpenODD 문서 → ODD 그래프(-odd.ttl) 생성기 (3.2절, 부록 E.4). PyYAML (2026-09-11 잠금)
py_binary(
    name = "odd2kg",
    srcs = ["odd2kg.py"],
    deps = [requirement("pyyaml")],
)

# 게이트 등록부 → 게이트 그래프(-kg.ttl) 생성기 (M1 단일 정의처, 2026-10-02). 게이트는 프로세스 층의 항목이고
# 개체 하나가 게이트 하나다 (id:gate-<게이트 id>). 원본은 //defs:kb.bzl 의 GATES 리터럴이라 kb_lib 의 리터럴
# 읽기를 그대로 쓴다. agt:judgedBy 의 대상은 등록부 사이드카의 파일 복합체이므로 사이드카가 액션의 입력이다
py_binary(
    name = "gates2kg",
    srcs = ["gates2kg.py"],
    deps = [":kb_lib"],
)

# 코어 지표 뷰 → metrics.md (4.13절, 14.1절). 문서는 수치를 적지 않고 이 생성물을 인용한다
py_binary(
    name = "metrics",
    srcs = ["metrics.py"],
    deps = [
        ":kb_lib",
        requirement("rdflib"),
    ],
)

# 역량 질문 질의 실행 — 활용 도구. 결과는 라벨 목록이다 (p4-label-is-the-interface)
py_binary(
    name = "query",
    srcs = ["query.py"],
    data = [":cq_queries"],
    deps = [
        ":kb_lib",
        requirement("rdflib"),
    ],
)

# 정합성 보고 뷰 — 중복·라벨 형식·용어 (p4-redundancy-as-safety-margin). 게이트가 아니다
py_binary(
    name = "consistency",
    srcs = [
        "chunk2kg.py",
        "consistency.py",
    ],
    main = "consistency.py",
    deps = [":kb_lib"],  # 종료 코드·waiver 표 읽기 (2026-09-12 A·C)
)

# 라벨 대표성 실험 — 층화 표본 + 미끼 (docs/feedback/label-representativeness-protocol.md)
py_binary(
    name = "label_sample",
    srcs = [
        "chunk2kg.py",
        "label_sample.py",
    ],
    main = "label_sample.py",
    deps = [":kb_lib"],  # 생성 문서 규약(머리 블록)의 단일 정의처
)

# BUILD 생성기 (bazel-dependency-review 2단계): frontmatter·owl:imports → 패키지 BUILD. 원본은 그래프, BUILD 는 뷰
py_binary(
    name = "gen_build",
    srcs = [
        "chunk2kg.py",
        "gen_build.py",
    ],
    main = "gen_build.py",
)

# 인수 (writer 검사 해소): 쓰기 역할이 검토한 청크에 verified 를 붙인다. bazel run //tools:endorse -- --by orchestrator/<모델> --at <시각> <파일>
py_binary(
    name = "endorse",
    srcs = ["endorse.py"],
)

# 읽기 집합 인수인계 (10.3절): workset 뷰의 펼친 청크 → 새 청크의 sources. 하네스 기록 전의 첫 형태
py_binary(
    name = "handoff",
    srcs = ["handoff.py"],
)

# 영향 분석 (12.6절): bazel run //tools:impact -- <타깃>. 링크 = deps 이므로 rdeps 가 영향 집합
py_binary(
    name = "impact",
    srcs = ["impact.py"],
    deps = [":kb_lib"],  # 생성 문서 규약(머리 블록)의 단일 정의처
)

# 작업 집합 뷰 (0.5절, 5.6절): 스코프 × 수준 창 → 라벨 목록 + 앵커 이웃, 예산 패킹
py_binary(
    name = "workset",
    srcs = ["workset.py"],
    args = ["--vocab=$(rootpath @tiktoken_o200k_base//file)"],
    data = ["@tiktoken_o200k_base//file"],  # 예산의 단위가 토큰이다 — 라벨 목록과 펼친 본문을 이 어휘로 센다
    deps = [
        ":kb_lib",
        requirement("rdflib"),
        requirement("tiktoken"),
    ],
)

# 커뮤니티 탐지 뷰 (p4-community-detection-proposes-composites): 링크 군집 → 복합체 후보·relatedTo 링크 후보. 채택은 사람 — 게이트가 아니다
py_binary(
    name = "community",
    srcs = ["community.py"],
    deps = [
        ":kb_lib",
        requirement("rdflib"),
    ],
)

# 미결 집계 뷰 (p4-three-empty-values): head 그래프의 `agt:bodySlot "미확정"` 인 청크 → 질문 · 청크 · plane/level · 상세 문서.
# 집계만 맡는다 — 상세 다섯 절은 docs/open-questions.md 색인과 그 아래 문서로 남는다. 게이트가 아니다
py_binary(
    name = "open_questions",
    srcs = ["open_questions.py"],
    deps = [
        ":kb_lib",
        requirement("rdflib"),
    ],
)

# 복원 후보 생성기 뷰 (로드맵 8단계 복원, p10-link-by-construction · p10-restored-link-marking): frontmatter 링크가 없는 쌍 → 체계 안 증거
# (cites · verifies 공동 커버 · usesConcept 교집합)로 후보, TIM·단방향 제약 검사, 앵커당 k ≤ 7. 확정은 사람이 restored: 로 — 게이트가 아니다
py_binary(
    name = "link",
    srcs = [
        "chunk2kg.py",
        "link.py",
    ],
    main = "link.py",
    deps = [
        ":kb_lib",
        requirement("rdflib"),
    ],
)

# 재검증 후보 (dependency-graph-design §5): bazel run //tools:revalidate -- [--base HEAD]. 본문 해시가 바뀐 청크의 링크·하류 의존자를 재판정 대상으로.
# git 과 bazel query 를 부르므로 odd_check 처럼 테스트 타깃이 아니다
py_binary(
    name = "revalidate",
    srcs = [
        "chunk2kg.py",
        "revalidate.py",
    ],
    main = "revalidate.py",
    deps = [":kb_lib"],  # 생성 문서 규약(머리 블록·빈 값 표기)의 단일 정의처
)

# ODD 모니터링 (3.5절): bazel run //tools:odd_check — CHECKS.cmd 실행, 이탈 보고. 네트워크·호스트 상태를 보므로 테스트 타깃이 아니다
py_binary(
    name = "odd_check",
    srcs = ["odd_check.py"],
    deps = [
        ":kb_lib",
        requirement("pyyaml"),
    ],
)

# 가정 판정과 전파 (6.9절, 도입 4단계 첫 형태): bazel run //tools:assume_check -- [--break <cond-id>…] [--record]
# 조건 판정은 odd_check 의 함수를 재사용하고(호스트 상태를 보므로 테스트 타깃이 아니다), 그래프는 data 로 놓여 실행 전에 빌드된다
py_binary(
    name = "assume_check",
    srcs = [
        "assume_check.py",
        "chunk2kg.py",
        "odd_check.py",
    ],
    data = [
        "//kb/odd:odd",
        "//kg",
        "//kg:chunks_kg",
        "//kg:references_kg",
        "//space:design_space",  # 설계 공간의 후보 링크 `when` 과 양립 제약도 같은 평가기로 판정한다
    ],
    main = "assume_check.py",
    deps = [
        ":kb_lib",
        requirement("pyyaml"),
        requirement("rdflib"),
    ],
)

# V&V executor (8.20절, 7단계 → 8단계): bazel run //tools:vv_run -- [--record] [--case <슬러그>…]
# 케이스의 `bazel test` 양성 명령을 실행하고 실행 기록(kb/vv/run/, memory plane, append-only)을 쓴다. 케이스·기록은 워크스페이스에서
# 읽고 쓰며 bazel 을 중첩 실행하므로(odd_check 와 같은 사유) 테스트 타깃이 아니다. 생성자 process:vv_run 은 역할이 아니라 writer 검사 밖이다
py_binary(
    name = "vv_run",
    srcs = [
        "chunk2kg.py",
        "vv_run.py",
    ],
    main = "vv_run.py",
    # 다른 도구와 같은 꼴로 어휘 경로를 명시한다 — runfiles 탐색은 canonical 저장소 이름에 달려 있어 배선의
    # 원본으로 쓸 수 없다. 실행기는 이 값을 KB_TOKENIZER_VOCAB 로 검증기에 넘긴다 (p8-verifier-env-isolation)
    args = ["--vocab=$(rootpath @tiktoken_o200k_base//file)"],
    data = ["@tiktoken_o200k_base//file"],  # 케이스의 검증기 명령에 토큰 계수기 어휘가 필요하다 — KB_TOKENIZER_VOCAB 자리 (p8-verifier-env-isolation)
    deps = [
        ":kb_lib",
        requirement("pyyaml"),  # 케이스 본문의 `yaml` 펜스 — 기계가 읽는 자극·기대 (p8-machine-readable-case)
        requirement("rdflib"),
        # 아래 셋은 vv_run 자신이 쓰지 않는다 — READ_ONLY_VERIFIERS(validate·chunk_lint·space2kg 등)가 bare `python3` 로
        # 불릴 때 vv_run 자신의 sys.path(하네스의 pip 폐포)를 PYTHONPATH 로 빌려주는 자리다 (verifier_env, p8-verifier-env-isolation).
        # 생략하면 그 검증기들이 `ModuleNotFoundError` 로 자극에 닿기 전에 죽는다(이 저장소 실측, 2026-10-01).
        requirement("tiktoken"),  # chunk_lint·chunk2kg·space2kg 의 토큰 계수기
        requirement("pyshacl"),   # validate 의 shacl 검사
        requirement("owlrl"),     # validate 의 --reason(OWL-RL 추론)
    ],
)

# 판정자 (8.14절, 결정 p8-judge-calibration-binding): bazel run //tools:judge -- --question <질문 id> [--fixture <json>] [--record]
# **게이트 밖 도구다** — 외부 서비스(구조화 출력 전용 모델)를 부르므로 테스트 타깃이 될 수 없다. 게이트는 판정 로그의 형식만
# 본다(게이트 id judge-log, chunk_lint). 질문·척도·임계는 프로파일 온톨로지와 shape 가 원본이라 data 로 놓아 runfiles 에서 읽는다.
# 자격은 환경 변수로만 받고 없으면 호출하지 않는다. 생성자 process:judge 는 역할이 아니라 writer 검사 밖이다
py_binary(
    name = "judge",
    srcs = [
        "chunk2kg.py",
        "judge.py",
    ],
    args = ["--vocab=$(rootpath @tiktoken_o200k_base//file)"],
    data = [
        "//kb/ontology:shapes",
        "//kb/ontology/profile/development",
        "@tiktoken_o200k_base//file",  # 판정 로그를 `memory` 상한 안으로 가르는 계수기 (p1-chunk-unit-is-tokens)
    ],
    main = "judge.py",
    deps = [
        ":kb_lib",
        requirement("rdflib"),
        requirement("tiktoken"),
    ],
)

# 실행기 환경 격리 게이트: bazel test //tools:vv_run_env_test
# 실행기 **전체**는 위 주석대로 테스트 타깃이 될 수 없다 — 케이스가 `bazel test` 를 부르므로 중첩 실행이 된다. 그러나 `clean_env()` 와
# `run_command()` 는 bazel 을 부르지 않는다. 판정 대상을 환경 격리의 동작으로 좁혀 케이스 실행 없이 `bazel test //...` 안에서 잰다
# (결정 p8-verifier-env-isolation, 논평 runner-env-leaks-into-case). 이름이 vv_run_test 가 아닌 까닭은 실행기 전체를 덮지 않기 때문이다
kb_runner_env_test(
    name = "vv_run_env_test",
    probe = "chunk_lint",
)

# 게이트 등록부 검사 (M1 단일 정의처, 2026-10-02): 코드의 태그 집합 = //defs:kb.bzl 의 GATES·TOOL_TAGS 리터럴.
# 그래프를 입력으로 받지 않는 유일한 validate 타깃이다 — 판정 대상이 소스 전수이므로 //kg:gate_test 에 묶지 않는다
# (묶으면 도구를 한 줄 고칠 때마다 그래프 게이트 전체가 다시 돈다). 게이트 id `gate-registry`
kb_gate_test(
    name = "gate_registry_test",
    gate_sources = [":tools"],
    gates = "//defs:kb.bzl",
)

# 라벨 목록 뷰 → index.md (5.6절, 부록 E.2). OKF 예약 파일은 생성물이다
py_binary(
    name = "labels",
    srcs = [
        "chunk2kg.py",
        "labels.py",
    ],
    main = "labels.py",
    deps = [":kb_lib"],  # 생성 문서 규약(머리 블록·목차·링크)의 단일 정의처
)

# 청크 본문의 인용 → 참조 그래프(-kg) 생성기 (8.2절). 대상이 없으면 실패한다. 후보 링크 개체의 IRI 규칙(뿌리 uuid · link_hash)은 chunk2kg 가 정의처
py_binary(
    name = "extract_refs",
    srcs = [
        "chunk2kg.py",
        "extract_refs.py",
    ],
    main = "extract_refs.py",
    deps = [
        ":kb_lib",
        requirement("rdflib"),
    ],
)

# 용어 제안 워크플로 (2.5절): 일반화이 온톨로지에 닿을 때 — 제안은 검사를 거쳐 승인 큐로
py_binary(
    name = "term_propose",
    srcs = ["term_propose.py"],
    deps = [
        ":kb_lib",
        requirement("rdflib"),
    ],
)

# 정규화 직렬화 (2.5절): bazel run //tools:canonicalize -- --write <files...>
py_binary(
    name = "canonicalize",
    srcs = ["canonicalize.py"],
    deps = [requirement("rdflib")],
)

# 문서 뷰 생성기 (4.6절 weave, p12-documents-are-generated): ADR · 요구 색인 · 변경 이력. 생성물은 bazel-bin 에만 (kb_weave: //kb/dev:adr …)
# 본문 파서(chunk2kg)와 생성 문서 규약(kb_lib.gendoc_header·heading_anchors)을 그대로 쓴다 — 단일 정의처
py_binary(
    name = "weave",
    srcs = [
        "chunk2kg.py",
        "weave.py",
    ],
    main = "weave.py",
    deps = [
        ":kb_lib",
        requirement("rdflib"),
    ],
)

# 코드 추출기 (코드를 청크로, 유저 승인 2026-09-30): tools/*.py + 등록부 → kb/dev/artifact/<모듈>/ 의 청크 트리.
# 드리프트 검사는 //:extract_drift_test (kb_extract_drift_test). 손으로: bazel run //tools:extract -- tools/kb_lib.py
py_binary(
    name = "extract",
    srcs = ["extract.py"],
    args = ["--vocab=$(rootpath @tiktoken_o200k_base//file)"],
    data = ["@tiktoken_o200k_base//file"],  # 생성 청크의 artifact 상한 보고 — 단위는 토큰이다
    deps = [
        ":kb_lib",
        requirement("rdflib"),
        requirement("tiktoken"),
    ],
)

# 테스트 통과 도장 (p7-code-extraction-direction "도장"): 등록부의 `tested` 를 갱신한다. `bazel test //...` PASS 뒤에만 돈다.
# 손으로: bazel run //tools:stamp -- tools/kb_lib.chunks.yml
py_binary(
    name = "stamp",
    srcs = [
        "extract.py",
        "stamp.py",
    ],
    main = "stamp.py",
    deps = [
        ":kb_lib",
        requirement("rdflib"),
    ],
)

# skill 생성기 (로드맵 6단계, agrtls K): 도구 docstring + kb_lib.SKILLS → .claude/skills/<도구>/SKILL.md (트리, 커밋 대상).
# 드리프트 검사는 //:skills_drift_test (kb_skills_drift_test). 손으로: python3 tools/gen_skills.py --root .
py_binary(
    name = "gen_skills",
    srcs = [
        "doccheck.py",
        "gen_skills.py",
    ],
    main = "gen_skills.py",
    deps = [
        ":kb_lib",
        requirement("rdflib"),
    ],
)

# 문서 현행성 (agrtls-practices-review N): 죽은 링크·앵커·백틱 경로. 게이트는 //:doccheck_test (kb_doccheck_test)
# 손으로: bazel run //tools:doccheck -- *.md docs/*.md docs/open-questions/*.md --target-only docs/agent-knowledge-system-notes.md
py_binary(
    name = "doccheck",
    srcs = ["doccheck.py"],
    deps = [":kb_lib"],
)

# 생성 문서 게이트 (유저 지시 2026-09-21): 생성 마크다운의 머리 블록·본문 서식·주장 건전성 G1~G18.
# 규약의 단일 정의처는 kb_lib 이고 게이트는 //:gendoc_test (kb_gendoc_test). 손으로: bazel run //tools:gendoc -- bazel-bin/kg/metrics.md
py_binary(
    name = "gendoc",
    srcs = ["gendoc.py"],
    deps = [":kb_lib"],
)

# 토큰 계수기 (유저 결정 2026-10-01 "청크의 단위는 토큰이다"): bazel run //tools:tokens -- [청크…] [--out report.md]
# 어휘 파일은 MODULE.bazel 의 http_file 이 sha256 으로 고정하고 data 로 runfiles 에 놓인다 — 네트워크를 쓰지 않는다.
# args 의 `$(rootpath …)` 가 그 경로를 넘긴다(사용자 인자보다 앞에 온다). chunk_lint.py 를 함께 싣는 까닭은
# frontmatter 파서(split_frontmatter)가 게이트와 같아야 하기 때문이다 — plane 을 읽는 규칙이 갈리면 분포의 분모가 갈린다
py_binary(
    name = "tokens",
    srcs = [
        "chunk2kg.py",
        "chunk_lint.py",
        "tokens.py",
    ],
    args = ["--vocab=$(rootpath @tiktoken_o200k_base//file)"],
    data = ["@tiktoken_o200k_base//file"],
    main = "tokens.py",
    deps = [
        ":kb_lib",
        requirement("tiktoken"),
    ],
)
