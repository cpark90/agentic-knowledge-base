load("@kb_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "validate.py",
    "chunk_lint.py",
    "channel_lint.py",
    "chunk2kg.py",
    "gen_build.py",
    "same_bytes.py",
    "extract_refs.py",
    "kb_lib.py",
    "requirements_lock.txt",
])

filegroup(
    name = "verify_queries",
    srcs = glob(["verify-queries/*.rq"]),
)

py_library(
    name = "kb_lib",
    srcs = ["kb_lib.py"],
    deps = [requirement("rdflib")],
)

# 게이트 도구를 손으로 돌릴 때: bazel run //tools:validate -- --ontology <files...>
py_binary(
    name = "validate",
    srcs = ["validate.py"],
    deps = [
        ":kb_lib",
        requirement("owlrl"),
        requirement("pyshacl"),
        requirement("rdflib"),
    ],
)

py_binary(
    name = "chunk_lint",
    srcs = ["chunk_lint.py"],
    deps = [":kb_lib"],
)

# 청크 파일(frontmatter) → head 그래프(-kg) 생성기. 한 청크는 한 파일 (4.3절, 4.9절)
py_binary(
    name = "chunk2kg",
    srcs = ["chunk2kg.py"],
)

# ODD 택소노미 뷰 (부록 E.4): related/condition → taxonomy.yml
py_binary(
    name = "taxonomy",
    srcs = ["taxonomy.py"],
    deps = [requirement("rdflib")],
)

# OpenODD 문서 → ODD 그래프(-odd.ttl) 생성기 (3.2절, 부록 E.4). PyYAML (2026-09-11 잠금)
py_binary(
    name = "odd2kg",
    srcs = ["odd2kg.py"],
    deps = [requirement("pyyaml")],
)

# 코어 지표 뷰 → metrics.md (4.13절, 14.1절). 문서는 수치를 적지 않고 이 생성물을 인용한다
py_binary(
    name = "metrics",
    srcs = ["metrics.py"],
    deps = [
        ":kb_lib",
        requirement("rdflib"),
    ],
)

# 정합성 보고 뷰 — 중복·라벨 형식·용어 (p4-redundancy-as-safety-margin). 게이트가 아니다
py_binary(
    name = "consistency",
    srcs = [
        "chunk2kg.py",
        "consistency.py",
    ],
    main = "consistency.py",
)

# 라벨 대표성 실험 — 층화 표본 + 미끼 (docs/feedback/label-representativeness-protocol.md)
py_binary(
    name = "label_sample",
    srcs = [
        "chunk2kg.py",
        "label_sample.py",
    ],
    main = "label_sample.py",
)

# BUILD 생성기 (bazel-dependency-review 2단계): frontmatter·owl:imports → 패키지 BUILD. 원본은 그래프, BUILD 는 뷰
py_binary(
    name = "gen_build",
    srcs = [
        "chunk2kg.py",
        "gen_build.py",
    ],
    main = "gen_build.py",
)

# 인수 (writer 검사 해소): 쓰기 역할이 검토한 청크에 verified 를 붙인다. bazel run //tools:endorse -- --by orchestrator/<모델> --at <시각> <파일>
py_binary(
    name = "endorse",
    srcs = ["endorse.py"],
)

# 읽기 집합 인수인계 (10.3절): workset 뷰의 펼친 청크 → 새 청크의 sources. 하네스 기록 전의 첫 형태
py_binary(
    name = "handoff",
    srcs = ["handoff.py"],
)

# 영향 분석 (12.6절): bazel run //tools:impact -- <타깃>. 링크 = deps 이므로 rdeps 가 영향 집합
py_binary(
    name = "impact",
    srcs = ["impact.py"],
)

# 작업 집합 뷰 (0.5절, 5.6절): 스코프 × 수준 창 → 라벨 목록 + 앵커 이웃, 예산 패킹
py_binary(
    name = "workset",
    srcs = ["workset.py"],
    deps = [requirement("rdflib")],
)

# 커뮤니티 탐지 뷰 (p4-community-detection-proposes-composites): 링크 군집 → 복합체 후보·relatedTo 링크 후보. 채택은 사람 — 게이트가 아니다
py_binary(
    name = "community",
    srcs = ["community.py"],
    deps = [requirement("rdflib")],
)

# 재검증 후보 (dependency-graph-design §5): bazel run //tools:revalidate -- [--base HEAD]. 본문 해시가 바뀐 청크의 링크·하류 의존자를 재판정 대상으로.
# git 과 bazel query 를 부르므로 odd_check 처럼 테스트 타깃이 아니다
py_binary(
    name = "revalidate",
    srcs = [
        "chunk2kg.py",
        "revalidate.py",
    ],
    main = "revalidate.py",
)

# ODD 모니터링 (3.5절): bazel run //tools:odd_check — CHECKS.cmd 실행, 이탈 보고. 네트워크·호스트 상태를 보므로 테스트 타깃이 아니다
py_binary(
    name = "odd_check",
    srcs = ["odd_check.py"],
    deps = [requirement("pyyaml")],
)

# 라벨 목록 뷰 → index.md (5.6절, 부록 E.2). OKF 예약 파일은 생성물이다
py_binary(
    name = "labels",
    srcs = [
        "chunk2kg.py",
        "labels.py",
    ],
    main = "labels.py",
)

# 청크 본문의 인용 → 참조 그래프(-kg) 생성기 (8.2절). 대상이 없으면 실패한다
py_binary(
    name = "extract_refs",
    srcs = ["extract_refs.py"],
    deps = [
        ":kb_lib",
        requirement("rdflib"),
    ],
)

# 용어 제안 워크플로 (2.5절): 일반화이 온톨로지에 닿을 때 — 제안은 검사를 거쳐 승인 큐로
py_binary(
    name = "term_propose",
    srcs = ["term_propose.py"],
    deps = [
        ":kb_lib",
        requirement("rdflib"),
    ],
)

# 정규화 직렬화 (2.5절): bazel run //tools:canonicalize -- --write <files...>
py_binary(
    name = "canonicalize",
    srcs = ["canonicalize.py"],
    deps = [requirement("rdflib")],
)
