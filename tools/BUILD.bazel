load("@kb_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//defs:knowledge.bzl", "kb_runner_env_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "validate.py",
    "canonicalize.py",
    "chunk_lint.py",
    "channel_lint.py",
    "chunk2kg.py",
    "doccheck.py",
    "gen_build.py",
    "gen_skills.py",
    "gendoc.py",
    "weave.py",
