load("@kb_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "validate.py",
    "chunk_lint.py",
    "extract_refs.py",
    "kb_lib.py",
    "kb_yaml.py",
    "requirements_lock.txt",
])

filegroup(
    name = "verify_queries",
    srcs = glob(["verify-queries/*.rq"]),
)

py_library(
    name = "kb_lib",
    srcs = ["kb_lib.py"],
    deps = [requirement("rdflib")],
)

# 게이트 도구를 손으로 돌릴 때: bazel run //tools:validate -- --ontology <files...>
py_binary(
    name = "validate",
    srcs = ["validate.py"],
    deps = [
        ":kb_lib",
        requirement("owlrl"),
        requirement("pyshacl"),
        requirement("rdflib"),
    ],
)

py_binary(
    name = "chunk_lint",
    srcs = ["chunk_lint.py"],
    deps = [":kb_lib"],
)

# 청크 파일(frontmatter) → head 그래프(-kg) 생성기. 한 청크는 한 파일 (4.3절, 4.9절)
py_binary(
    name = "chunk2kg",
    srcs = ["chunk2kg.py"],
)

# ODD 택소노미 투영 (부록 E.4): related/condition → taxonomy.yml
py_binary(
    name = "taxonomy",
    srcs = ["taxonomy.py"],
    deps = [requirement("rdflib")],
)

# OpenODD 문서 → ODD 그래프(-odd.ttl) 생성기 (3.2절, 부록 E.4). YAML 부분집합 로더 kb_yaml 사용
py_binary(
    name = "odd2kg",
    srcs = [
        "kb_yaml.py",
        "odd2kg.py",
    ],
    main = "odd2kg.py",
)

# 골격 지표 투영 → metrics.md (4.13절, 14.1절). 문서는 수치를 적지 않고 이 생성물을 인용한다
py_binary(
    name = "metrics",
    srcs = ["metrics.py"],
    deps = [requirement("rdflib")],
)

# 라벨 목록 투영 → index.md (5.6절, 부록 E.2). OKF 예약 파일은 생성물이다
py_binary(
    name = "labels",
    srcs = [
        "chunk2kg.py",
        "labels.py",
    ],
    main = "labels.py",
)

# 청크 본문의 인용 → 참조 그래프(-kg) 생성기 (8.2절). 대상이 없으면 실패한다
py_binary(
    name = "extract_refs",
    srcs = ["extract_refs.py"],
)

# 용어 제안 워크플로 (2.5절): 상승이 온톨로지에 닿을 때 — 제안은 검사를 거쳐 승인 큐로
py_binary(
    name = "term_propose",
    srcs = ["term_propose.py"],
    deps = [
        ":kb_lib",
        requirement("rdflib"),
    ],
)

# 정규화 직렬화 (2.5절): bazel run //tools:canonicalize -- --write <files...>
py_binary(
    name = "canonicalize",
    srcs = ["canonicalize.py"],
    deps = [requirement("rdflib")],
)
