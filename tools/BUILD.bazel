# 재검증 후보 (dependency-graph-design §5): bazel run //tools:revalidate -- [--base HEAD]. 본문 해시가 바뀐 청크의 링크·하류 의존자를 재판정 대상으로.
# git 과 bazel query 를 부르므로 odd_check 처럼 테스트 타깃이 아니다
py_binary(
    name = "revalidate",
    srcs = [
        "chunk2kg.py",
        "revalidate.py",
    ],
    main = "revalidate.py",
    deps = [":kb_lib"],  # 생성 문서 규약(머리 블록·빈 값 표기)의 단일 정의처
)

# ODD 모니터링 (3.5절): bazel run //tools:odd_check — CHECKS.cmd 실행, 이탈 보고. 네트워크·호스트 상태를 보므로 테스트 타깃이 아니다
py_binary(
    name = "odd_check",
    srcs = ["odd_check.py"],
    deps = [
        ":kb_lib",
        requirement("pyyaml"),
    ],
)

# 가정 판정과 전파 (6.9절, 도입 4단계 첫 형태): bazel run //tools:assume_check -- [--break <cond-id>…] [--record]
# 조건 판정은 odd_check 의 함수를 재사용하고(호스트 상태를 보므로 테스트 타깃이 아니다), 그래프는 data 로 놓여 실행 전에 빌드된다
py_binary(
    name = "assume_check",
    srcs = [
        "assume_check.py",
        "chunk2kg.py",
        "odd_check.py",
    ],
    data = [
        "//kb/odd:odd",
        "//kg",
        "//kg:chunks_kg",
        "//kg:references_kg",
        "//space:design_space",  # 설계 공간의 후보 링크 `when` 과 양립 제약도 같은 평가기로 판정한다
    ],
    main = "assume_check.py",
    deps = [
        ":kb_lib",
        requirement("pyyaml"),
        requirement("rdflib"),
    ],
)

# V&V executor (8.20절, 7단계 → 8단계): bazel run //tools:vv_run -- [--record] [--case <슬러그>…]
# 케이스의 `bazel test` 양성 명령을 실행하고 실행 기록(kb/vv/run/, memory plane, append-only)을 쓴다. 케이스·기록은 워크스페이스에서
# 읽고 쓰며 bazel 을 중첩 실행하므로(odd_check 와 같은 사유) 테스트 타깃이 아니다. 생성자 process:vv_run 은 역할이 아니라 writer 검사 밖이다
py_binary(
    name = "vv_run",
    srcs = [
        "chunk2kg.py",
        "vv_run.py",
    ],
    main = "vv_run.py",
    deps = [
        ":kb_lib",
        requirement("pyyaml"),  # 케이스 본문의 `yaml` 펜스 — 기계가 읽는 자극·기대 (p8-machine-readable-case)
        requirement("rdflib"),
    ],
)

# 실행기 환경 격리 게이트: bazel test //tools:vv_run_env_test
# 실행기 **전체**는 위 주석대로 테스트 타깃이 될 수 없다 — 케이스가 `bazel test` 를 부르므로 중첩 실행이 된다. 그러나 `clean_env()` 와
# `run_command()` 는 bazel 을 부르지 않는다. 판정 대상을 환경 격리의 동작으로 좁혀 케이스 실행 없이 `bazel test //...` 안에서 잰다
# (결정 p8-verifier-env-isolation, 논평 runner-env-leaks-into-case). 이름이 vv_run_test 가 아닌 까닭은 실행기 전체를 덮지 않기 때문이다
kb_runner_env_test(
    name = "vv_run_env_test",
    probe = "chunk_lint",
)

