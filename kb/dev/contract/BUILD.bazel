# 생성 파일 — 손으로 고치지 않는다. 원본은 각 청크의 frontmatter (tools/gen_build.py). 검사: //:build_drift_test

load("//defs:kb.bzl", "kb_bundle", "kb_chunk")

package(default_visibility = ["//kb:contract_readers"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "contract",
    srcs = glob(
        ["*.md"],
        allow_empty = True,
    ),
)

kb_chunk(
    name = "parse-chunk",
    src = "parse-chunk.md",
    iri = "https://agentic-knowledge-base.dev/id/chunk/87506246-db94-40b9-8b81-adb8ebe7bd21",
    plane = "contract",
    level = "abstract",
    status = "draft",
)

kb_chunk(
    name = "parse-chunk-error-list",
    src = "parse-chunk-error-list.md",
    iri = "https://agentic-knowledge-base.dev/id/chunk/438d6c82-6afd-421b-bd64-8343053438ce",
    plane = "contract",
    level = "logical",
    status = "draft",
    refines = [
        "//kb/dev/contract:parse-chunk",
    ],
)

kb_chunk(
    name = "parse-chunk-raises",
    src = "parse-chunk-raises.md",
    iri = "https://agentic-knowledge-base.dev/id/chunk/ed5b49af-8e81-4f81-b74e-9f795c588072",
    plane = "contract",
    level = "logical",
    status = "draft",
    refines = [
        "//kb/dev/contract:parse-chunk",
    ],
)

kb_chunk(
    name = "parse-chunk-result-object",
    src = "parse-chunk-result-object.md",
    iri = "https://agentic-knowledge-base.dev/id/chunk/7d400d4e-5ef5-4ec7-9efa-3c9fb35c0aea",
    plane = "contract",
    level = "logical",
    status = "draft",
    refines = [
        "//kb/dev/contract:parse-chunk",
    ],
)

# 이 패키지의 head 그래프 조각 묶음 — //kg:chunks_kg 가 병합한다
kb_bundle(
    name = "kg",
    items = [
        ":parse-chunk",
        ":parse-chunk-error-list",
        ":parse-chunk-raises",
        ":parse-chunk-result-object",
    ],
)
