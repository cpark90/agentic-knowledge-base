# 개발 KB — 요구에서 실산출물을 생산하기 위한 지식 (노트 7.1절).
# plane별 하위 패키지(requirement/ decision/ …)의 BUILD 는 tools/gen_build.py 가 frontmatter 에서 생성한다.
load("//defs:knowledge.bzl", "kb_chunk_lint_test", "kb_index")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "bodies",
    srcs = [
        "//kb/dev/decision:bodies",
        "//kb/dev/requirement:bodies",
    ] + glob(
        ["*.md"],
        allow_empty = True,
    ),
)

kb_chunk_lint_test(
    name = "lint_test",
    chunks = [":bodies"],
)

# 라벨 목록 — OKF index.md는 생성물이다 (bazel build //kb/dev:index → bazel-bin/kb/dev/index.md)
kb_index(
    name = "index",
    srcs = [":bodies"],
)
