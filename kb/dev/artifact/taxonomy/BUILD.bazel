# 생성 파일 — 손으로 고치지 않는다. 원본은 각 청크의 frontmatter (tools/gen_build.py). 검사: //:build_drift_test

load("//defs:kb.bzl", "kb_bundle", "kb_chunk", "kb_composite")

package(default_visibility = ["//kb:artifact_readers"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "bodies",
    srcs = glob(["*.md"]),
)

kb_composite(
    name = "module",
    srcs = [
        "fn-main.md",
        "head.md",
        "module.md",
        "sec-main.md",
    ],
    iri = "https://agentic-knowledge-base.dev/id/composite/5cd36157-e133-4ff0-bb51-ba6848ba0fbd",
    ordered = ["https://agentic-knowledge-base.dev/id/chunk/205f5607-e950-444d-b697-1bf3f4449223", "https://agentic-knowledge-base.dev/id/composite/9027036d-a39d-4b9e-b7c2-40b3cddb625f"],
    part_iris = ["https://agentic-knowledge-base.dev/id/chunk/205f5607-e950-444d-b697-1bf3f4449223", "https://agentic-knowledge-base.dev/id/composite/9027036d-a39d-4b9e-b7c2-40b3cddb625f"],
    plane = "artifact",
    level = "executable",
    status = "stable",
    refines = [
        "//kb/dev/decision:p0-condition-taxonomy",
        "//kb/dev/decision:p3-odd-derivations-and-gate",
    ],
)

# 이 패키지의 head 그래프 조각 묶음 — //kg:chunks_kg 가 병합한다
kb_bundle(
    name = "kg",
    items = [
        ":module",
    ],
)
