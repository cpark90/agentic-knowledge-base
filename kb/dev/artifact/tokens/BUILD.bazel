    name = "module",
    srcs = [
        "fn-budget_lines.md",
        "fn-discover.md",
        "fn-main.md",
        "fn-measure.md",
        "fn-multiple_table.md",
        "fn-plane_table.md",
        "fn-quantiles.md",
        "fn-render.md",
        "fn-top_table.md",
        "head.md",
        "module.md",
        "sec-discover.md",
        "sec-plane-table.md",
    ],
    iri = "https://agentic-knowledge-base.dev/id/composite/4fe35c96-c167-4a3e-b640-a888f6bcefe5",
    ordered = ["https://agentic-knowledge-base.dev/id/chunk/47cbe988-791e-493e-b71c-1671f649b23a", "https://agentic-knowledge-base.dev/id/composite/ee6ebd51-06bf-439a-875f-bf4afa341c35", "https://agentic-knowledge-base.dev/id/composite/bb329900-d369-44b7-88d4-5e3996dc0aa5"],
    part_iris = ["https://agentic-knowledge-base.dev/id/chunk/47cbe988-791e-493e-b71c-1671f649b23a", "https://agentic-knowledge-base.dev/id/composite/ee6ebd51-06bf-439a-875f-bf4afa341c35", "https://agentic-knowledge-base.dev/id/composite/bb329900-d369-44b7-88d4-5e3996dc0aa5"],
    plane = "artifact",
    level = "executable",
    status = "stable",
    refines = [
        "//kb/dev/decision:p1-chunk-unit-is-tokens",
    ],
)

# 이 패키지의 head 그래프 조각 묶음 — //kg:chunks_kg 가 병합한다
kb_bundle(
    name = "kg",
    items = [
        ":module",
    ],
)
