# 생성 파일 — 손으로 고치지 않는다. 원본은 각 청크의 frontmatter (tools/gen_build.py). 검사: //:build_drift_test

load("//defs:kb.bzl", "kb_bundle", "kb_chunk", "kb_composite")

package(default_visibility = ["//kb:artifact_readers"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "choices",
    srcs = glob(["*.md"]),
)

kb_composite(
    name = "module",
    srcs = [
        "fn-evidence.md",
        "fn-main.md",
        "fn-name.md",
        "fn-one.md",
        "head.md",
        "module.md",
        "sec-one.md",
    ],
    iri = "https://agentic-knowledge-base.dev/id/composite/020b2093-af80-4cce-8bce-86ac125c1c4a",
    ordered = ["https://agentic-knowledge-base.dev/id/chunk/454b2f0a-c75b-42fd-aad2-d24b00a2eb3b", "https://agentic-knowledge-base.dev/id/composite/6c9da832-fd4f-4fba-a0f6-33561303de46"],
    part_iris = ["https://agentic-knowledge-base.dev/id/chunk/454b2f0a-c75b-42fd-aad2-d24b00a2eb3b", "https://agentic-knowledge-base.dev/id/composite/6c9da832-fd4f-4fba-a0f6-33561303de46"],
    plane = "artifact",
    level = "executable",
    status = "stable",
    refines = [
        "//kb/dev/decision:p9-candidate-storage",
    ],
)

# 이 패키지의 head 그래프 조각 묶음 — //kg:chunks_kg 가 병합한다
kb_bundle(
    name = "kg",
    items = [
        ":module",
    ],
)
