# 생성 파일 — 손으로 고치지 않는다. 원본은 각 청크의 frontmatter (tools/gen_build.py). 검사: //:build_drift_test

load("//defs:kb.bzl", "kb_bundle", "kb_chunk", "kb_composite")

package(default_visibility = ["//kb:artifact_readers"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "vv_run_env_test",
    srcs = glob(["*.md"]),
)

kb_composite(
    name = "module",
    srcs = [
        "fn-check_cwd.md",
        "fn-check_strip.md",
        "fn-check_subprocess.md",
        "fn-main.md",
        "fn-poison.md",
        "head.md",
        "module.md",
        "sec-main.md",
        "sec-poison.md",
    ],
    iri = "https://agentic-knowledge-base.dev/id/composite/3c8e6ba3-aa11-4e78-b59f-c1aac562f7ce",
    ordered = ["https://agentic-knowledge-base.dev/id/chunk/585ec158-a9d6-48ce-8ecb-f52c92d2544b", "https://agentic-knowledge-base.dev/id/composite/78211421-fa91-4809-8250-0a840db49298", "https://agentic-knowledge-base.dev/id/composite/491eacc1-0150-4673-96c8-52951bec7409"],
    part_iris = ["https://agentic-knowledge-base.dev/id/chunk/585ec158-a9d6-48ce-8ecb-f52c92d2544b", "https://agentic-knowledge-base.dev/id/composite/78211421-fa91-4809-8250-0a840db49298", "https://agentic-knowledge-base.dev/id/composite/491eacc1-0150-4673-96c8-52951bec7409"],
    plane = "artifact",
    level = "executable",
    status = "stable",
    refines = [
        "//kb/dev/decision:p8-verifier-env-isolation",
    ],
)

# 이 패키지의 head 그래프 조각 묶음 — //kg:chunks_kg 가 병합한다
kb_bundle(
    name = "kg",
    items = [
        ":module",
    ],
)
