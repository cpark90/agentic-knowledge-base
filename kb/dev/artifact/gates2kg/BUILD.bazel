# 생성 파일 — 손으로 고치지 않는다. 원본은 각 단위 지식의 frontmatter (tools/gen_build.py). 검사: //:build_drift_test

load("//defs:kb.bzl", "kb_bundle", "kb_chunk")

package(default_visibility = ["//kb:artifact_readers"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "gates2kg",
    srcs = glob(["*.md"]),
)

kb_chunk(
    name = "module",
    src = "module.md",
    iri = "https://agentic-knowledge-base.dev/id/chunk/3365f616-57b5-475b-b2a4-955e5d05881c",
    plane = "artifact",
    level = "executable",
    status = "stable",
    refines = [
        "//kb/dev/decision:p0-service-is-a-three-layer-wiki",
        "//kb/dev/decision:p6-gate-catalogue",
    ],
)

# 이 패키지의 head 그래프 조각 묶음 — //kg:chunks_kg 가 병합한다
kb_bundle(
    name = "kg",
    items = [
        ":module",
    ],
)
