# 생성 파일 — 손으로 고치지 않는다. 원본은 각 단위 지식의 frontmatter (tools/gen_build.py). 검사: //:build_drift_test

load("//defs:kb.bzl", "kb_bundle", "kb_chunk")

package(default_visibility = ["//kb:artifact_readers"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "channel_lint",
    srcs = glob(["*.md"]),
)

kb_chunk(
    name = "module",
    src = "module.md",
    iri = "https://agentic-knowledge-base.dev/id/chunk/ae6d4d38-8012-4802-9b53-8c33d4293291",
    plane = "artifact",
    level = "executable",
    status = "stable",
    refines = [
        "//kb/dev/decision:p12-user-feedback-space-file",
        "//kb/dev/decision:p7-dev-roles-and-scopes",
    ],
)

# 이 패키지의 head 그래프 조각 묶음 — //kg:chunks_kg 가 병합한다
kb_bundle(
    name = "kg",
    items = [
        ":module",
    ],
)
