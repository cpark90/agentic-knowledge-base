# 생성 파일 — 손으로 고치지 않는다. 원본은 각 청크의 frontmatter (tools/gen_build.py). 검사: //:build_drift_test

load("//defs:kb.bzl", "kb_bundle", "kb_chunk", "kb_composite")

package(default_visibility = ["//kb:artifact_readers"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "bodies",
    srcs = glob(["*.md"]),
)

kb_composite(
    name = "module",
    srcs = [
        "fn-classify.md",
        "fn-esc.md",
        "fn-load_yaml.md",
        "fn-main.md",
        "head.md",
        "module.md",
        "sec-load-yaml.md",
    ],
    iri = "https://agentic-knowledge-base.dev/id/composite/50c525bb-02f0-4c2b-a9e0-1a3b666fbd3c",
    ordered = ["https://agentic-knowledge-base.dev/id/chunk/fb4cc423-29a9-4491-a1e8-a630c1b5a123", "https://agentic-knowledge-base.dev/id/composite/f9e4439a-33de-4e81-bb1a-e3ffec0bf77d"],
    part_iris = ["https://agentic-knowledge-base.dev/id/chunk/fb4cc423-29a9-4491-a1e8-a630c1b5a123", "https://agentic-knowledge-base.dev/id/composite/f9e4439a-33de-4e81-bb1a-e3ffec0bf77d"],
    plane = "artifact",
    level = "executable",
    status = "stable",
    refines = [
        "//kb/dev/decision:p3-odd-derivations-and-gate",
        "//kb/dev/decision:p3-odd-is-a-document",
    ],
)

# 이 패키지의 head 그래프 조각 묶음 — //kg:chunks_kg 가 병합한다
kb_bundle(
    name = "kg",
    items = [
        ":module",
    ],
)
