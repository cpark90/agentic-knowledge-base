# 생성 파일 — 손으로 고치지 않는다. 원본은 각 단위 지식의 frontmatter (tools/gen_build.py). 검사: //:build_drift_test

load("//defs:kb.bzl", "kb_bundle", "kb_chunk")

package(default_visibility = ["//kb:artifact_readers"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "chunk2kg",
    srcs = glob(["*.md"]),
)

kb_chunk(
    name = "module",
    src = "module.md",
    iri = "https://agentic-knowledge-base.dev/id/chunk/072c3853-c694-43fd-a8b9-c834aa2e363e",
    plane = "artifact",
    level = "executable",
    status = "stable",
    refines = [
        "//kb/dev/contract:parse-chunk-raises",
        "//kb/dev/decision:p4-chunk-as-four-named-graphs",
        "//kb/dev/decision:p4-chunk-iri-is-the-anchor",
        "//kb/dev/decision:p4-composite-order-is-declared",
        "//kb/dev/decision:p4-plane-subclass-level-property",
    ],
)

# 이 패키지의 head 그래프 조각 묶음 — //kg:chunks_kg 가 병합한다
kb_bundle(
    name = "kg",
    items = [
        ":module",
    ],
)
