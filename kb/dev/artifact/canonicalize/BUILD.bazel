# 생성 파일 — 손으로 고치지 않는다. 원본은 각 청크의 frontmatter (tools/gen_build.py). 검사: //:build_drift_test

load("//defs:kb.bzl", "kb_bundle", "kb_chunk", "kb_composite")

package(default_visibility = ["//kb:artifact_readers"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "canonicalize",
    srcs = glob(["*.md"]),
)

kb_composite(
    name = "module",
    srcs = [
        "fn-_shorten.md",
        "fn-_term.md",
        "fn-canonical_text.md",
        "fn-main.md",
        "head.md",
        "module.md",
        "sec--shorten.md",
    ],
    iri = "https://agentic-knowledge-base.dev/id/composite/cf91a784-b983-40fa-afff-ff9105164656",
    ordered = ["https://agentic-knowledge-base.dev/id/chunk/811c8a9a-7991-488b-927b-a703841a532b", "https://agentic-knowledge-base.dev/id/composite/29d788bd-8690-47f5-8a29-184a6e40d389"],
    part_iris = ["https://agentic-knowledge-base.dev/id/chunk/811c8a9a-7991-488b-927b-a703841a532b", "https://agentic-knowledge-base.dev/id/composite/29d788bd-8690-47f5-8a29-184a6e40d389"],
    plane = "artifact",
    level = "executable",
    status = "stable",
    refines = [
        "//kb/dev/decision:p2-ontology-compiler-three-tiers",
    ],
)

# 이 패키지의 head 그래프 조각 묶음 — //kg:chunks_kg 가 병합한다
kb_bundle(
    name = "kg",
    items = [
        ":module",
    ],
)
