# 생성 파일 — 손으로 고치지 않는다. 원본은 각 청크의 frontmatter (tools/gen_build.py). 검사: //:build_drift_test

load("//defs:kb.bzl", "kb_bundle", "kb_chunk", "kb_composite")

package(default_visibility = ["//kb:artifact_readers"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "bodies",
    srcs = glob(["*.md"]),
)

kb_composite(
    name = "module",
    srcs = [
        "fn-cell.md",
        "fn-main.md",
        "fn-question_of.md",
        "head.md",
        "module.md",
        "sec-cell.md",
    ],
    iri = "https://agentic-knowledge-base.dev/id/composite/4fe6beea-c6ab-454b-bad0-2cfede25066c",
    ordered = ["https://agentic-knowledge-base.dev/id/chunk/611551cc-ec21-4187-a12d-6a843751700f", "https://agentic-knowledge-base.dev/id/composite/ee1861ba-64c4-4bbb-8da8-cfc4336823c0"],
    part_iris = ["https://agentic-knowledge-base.dev/id/chunk/611551cc-ec21-4187-a12d-6a843751700f", "https://agentic-knowledge-base.dev/id/composite/ee1861ba-64c4-4bbb-8da8-cfc4336823c0"],
    plane = "artifact",
    level = "executable",
    status = "stable",
    refines = [
        "//kb/dev/decision:p4-slot-answers-one-question",
        "//kb/dev/decision:p4-three-empty-values",
    ],
)

# 이 패키지의 head 그래프 조각 묶음 — //kg:chunks_kg 가 병합한다
kb_bundle(
    name = "kg",
    items = [
        ":module",
    ],
)
