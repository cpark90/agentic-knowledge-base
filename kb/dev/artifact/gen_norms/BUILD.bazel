# 생성 파일 — 손으로 고치지 않는다. 원본은 각 단위 지식의 frontmatter (tools/gen_build.py). 검사: //:build_drift_test

load("//defs:kb.bzl", "kb_bundle", "kb_chunk")

package(default_visibility = ["//kb:artifact_readers"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "gen_norms",
    srcs = glob(["*.md"]),
)

kb_chunk(
    name = "module",
    src = "module.md",
    iri = "https://agentic-knowledge-base.dev/id/chunk/73abbe6d-7ee4-4c1d-8f71-4c1bc57951ac",
    plane = "artifact",
    level = "executable",
    status = "stable",
    refines = [
        "//kb/dev/decision:p12-norm-documents-from-section-chunks",
    ],
)

# 이 패키지의 head 그래프 조각 묶음 — //kg:chunks_kg 가 병합한다
kb_bundle(
    name = "kg",
    items = [
        ":module",
    ],
)
