# 생성 파일 — 손으로 고치지 않는다. 원본은 각 단위 지식의 frontmatter (tools/gen_build.py). 검사: //:build_drift_test

load("//defs:kb.bzl", "kb_bundle", "kb_chunk")

package(default_visibility = ["//kb:artifact_readers"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "assume_check",
    srcs = glob(["*.md"]),
)

kb_chunk(
    name = "module",
    src = "module.md",
    iri = "https://agentic-knowledge-base.dev/id/chunk/ec773001-5697-45eb-94ad-50f56f7085aa",
    plane = "artifact",
    level = "executable",
    status = "stable",
    refines = [
        "//kb/dev/decision:p0-run-is-an-append-only-memory-chunk",
        "//kb/dev/decision:p6-assumption-invalidation",
        "//kb/dev/decision:p6-assumption-verification-methods",
    ],
)

# 이 패키지의 head 그래프 조각 묶음 — //kg:chunks_kg 가 병합한다
kb_bundle(
    name = "kg",
    items = [
        ":module",
    ],
)
