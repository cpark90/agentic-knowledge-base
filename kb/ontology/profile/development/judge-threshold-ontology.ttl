# 개발 프로파일 — 판정의 임계는 일치율이다: 판정 로그와 그 행의 어휘 (결정 p8-judge-session-agreement 규칙 ②·③)
# 확신도 임계 셋의 어휘는 폐기로 남긴다 (Q-0056 Q119-a, 2026-10-24)
@prefix agt: <https://agentic-knowledge-base.dev/agt/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

agt:JudgementLog a owl:Class ;
    rdfs:label "judgement log"@en , "판정 로그"@ko ;
    skos:definition "판정자 세션들이 한 질문에 낸 답의 기록 하나. 판정자 둘 이상의 답과 미끼 검출 결과를 갖는다. 게이트: confidence-threshold-shapes."@ko .

agt:JudgementRow a owl:Class ;
    rdfs:label "judgement row"@en , "판정 행"@ko ;
    skos:definition "판정 로그의 행 하나. 판정자 하나가 대상 하나에 낸 값과 확신도, 처리, 일치 여부를 갖는다."@ko .

agt:hasJudgementRow a owl:ObjectProperty ;
    rdfs:domain agt:JudgementLog ;
    rdfs:range agt:JudgementRow ;
    rdfs:label "has judgement row"@en , "판정 행을 갖는다"@ko ;
    skos:definition "판정 로그에서 그 표의 행으로 가는 속성."@ko .

agt:judgeId a owl:DatatypeProperty ;
    rdfs:domain agt:JudgementRow ;
    rdfs:range xsd:string ;
    rdfs:label "judge identifier"@en , "판정자 식별자"@ko ;
    skos:definition "답한 판정자 세션의 식별자다."@ko .

agt:judgeConfidence a owl:DatatypeProperty ;
    rdfs:domain agt:JudgementRow ;
    rdfs:range xsd:decimal ;
    rdfs:label "judge confidence"@en , "확신도"@ko ;
    skos:definition "판정자가 값과 함께 낸 0 이상 1 이하의 확신도. 자기 보고라 처리를 가르지 않는다."@ko .

agt:judgeAgreement a owl:DatatypeProperty ;
    rdfs:domain agt:JudgementRow ;
    rdfs:range xsd:string ;
    rdfs:label "judge agreement"@en , "일치 여부"@ko ;
    skos:definition "같은 대상에 답한 판정자들의 값이 같은가. 값은 일치, 불일치, 해당 없음(단독 응답)이다."@ko .

agt:judgeRoute a owl:DatatypeProperty ;
    rdfs:domain agt:JudgementRow ;
    rdfs:range xsd:string ;
    rdfs:label "judge route"@en , "처리"@ko ;
    skos:definition "판정 행의 처리. 값은 자동 적용, 사람 확인 큐, 판정 보류이고 단독 응답은 자동 적용이 될 수 없다."@ko .

agt:decoyResult a owl:DatatypeProperty ;
    rdfs:domain agt:JudgementLog ;
    rdfs:range xsd:string ;
    rdfs:label "decoy detection result"@en , "미끼 검출 결과"@ko ;
    skos:definition "판정 로그의 미끼 검출 결과. 미끼가 없으면 해당 없음과 그 사유를 적는다."@ko .

agt:ConfidenceThresholdSet a owl:Class ;
    owl:deprecated true ;
    rdfs:label "confidence threshold set (deprecated)"@en , "확신도 임계 셋 (폐기)"@ko ;
    skos:definition "폐기 (2026-10-24). 대체는 agt:JudgementLog 다."@ko .

agt:autoApplyThreshold a owl:DatatypeProperty ;
    owl:deprecated true ;
    rdfs:domain agt:ConfidenceThresholdSet ;
    rdfs:range xsd:decimal ;
    rdfs:label "auto apply threshold (deprecated)"@en , "자동 적용 임계 (폐기)"@ko ;
    skos:definition "폐기 (2026-10-24). 대체는 agt:judgeAgreement 다."@ko .

agt:humanReviewThreshold a owl:DatatypeProperty ;
    owl:deprecated true ;
    rdfs:domain agt:ConfidenceThresholdSet ;
    rdfs:range xsd:decimal ;
    rdfs:label "human review threshold (deprecated)"@en , "사람 확인 임계 (폐기)"@ko ;
    skos:definition "폐기 (2026-10-24). 대체는 agt:judgeRoute 다."@ko .

agt:judgeThresholds a owl:NamedIndividual , agt:ConfidenceThresholdSet ;
    owl:deprecated true ;
    rdfs:label "judge confidence thresholds (deprecated)"@en , "판정자 확신도 임계 (폐기)"@ko ;
    skos:definition "폐기 (2026-10-24). 도구는 이 개체를 읽지 않는다."@ko .
