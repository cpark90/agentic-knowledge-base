# 태그 — 실행 기록과 검증 산출물의 분류는 계층이 아니라 태그로 (노트 0.5절 v3)
# 범주 자체의 추가는 온톨로지 확장, 태그 값의 추가는 그 범주의 출처 어휘 확장이다.
@prefix agt: <https://agentic-knowledge-base.dev/agt/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

agt:TagCategory a owl:Class ;
    rdfs:label "tag category"@en , "태그 범주"@ko ;
    skos:definition "태그가 속하는 범주. 범주가 없으면 태그가 무한히 늘고 검색이 불가능해진다. 범주는 서로 배타적일 필요가 없고, 태그 집합의 포함 관계가 범주의 포함 관계가 된다 (0.5절)."@ko .

agt:taggedWith a owl:ObjectProperty ;
    rdfs:domain agt:KnowledgeItem ;
    rdfs:label "tagged with"@en , "태그된다"@ko ;
    skos:definition "항목에 붙는 태그. 값은 반드시 온톨로지 개념이다 — 자유 문자열 태그는 검색 불가능한 태그다 (0.5절)."@ko .

agt:inTagCategory a owl:ObjectProperty ;
    rdfs:range agt:TagCategory ;
    rdfs:label "in tag category"@en , "태그 범주에 속한다"@ko ;
    skos:definition "태그 값(온톨로지 개념)이 어느 범주의 값인지 선언한다. 값의 출처 어휘가 범주마다 정해져 있다 (0.5절)."@ko .

### 범주 9종 (0.5절 표)

agt:actorCategory a owl:NamedIndividual , agt:TagCategory ;
    rdfs:label "actor"@en , "행위자"@ko ;
    skos:definition "값의 출처: 에이전트 카탈로그 역할, 유저, 외부 서비스. 예: role:developer (0.5절)."@ko .

agt:conditionCategory a owl:NamedIndividual , agt:TagCategory ;
    rdfs:label "condition"@en , "조건"@ko ;
    skos:definition "값의 출처: ODD 속성과 값. 예: env:offline (0.5절)."@ko .

agt:purposeCategory a owl:NamedIndividual , agt:TagCategory ;
    rdfs:label "purpose"@en , "목적"@ko ;
    skos:definition "값의 출처: 고정 어휘 — regression·exploration·acceptance·performance·recovery (0.5절)."@ko .

agt:defectFactorCategory a owl:NamedIndividual , agt:TagCategory ;
    rdfs:label "defect factor"@en , "결함 요인"@ko ;
    skos:definition "값의 출처: defect 어휘. 예: factor:cognitive/stale (0.5절, 7.17절)."@ko .

agt:originCategory a owl:NamedIndividual , agt:TagCategory ;
    rdfs:label "origin"@en , "출처"@ko ;
    skos:definition "값의 출처: 고정 어휘 — observed(실행 기록에서 일반화)·designed(설계에서 파생)·imported (0.5절)."@ko .

agt:oddRelationCategory a owl:NamedIndividual , agt:TagCategory ;
    rdfs:label "ODD relation"@en , "ODD 관계"@ko ;
    skos:definition "값의 출처: 고정 어휘 — inside·boundary·outside. ODD 밖 항목을 안과 섞으면 커버리지가 왜곡된다 (0.5절, 3.3절)."@ko .

agt:environmentCategory a owl:NamedIndividual , agt:TagCategory ;
    rdfs:label "environment"@en , "환경"@ko ;
    skos:definition "값의 출처: 검증 환경 계층 — unit·model·sil·hil·staging·production (0.5절, 7.9절)."@ko .

agt:targetCategory a owl:NamedIndividual , agt:TagCategory ;
    rdfs:label "target"@en , "대상"@ko ;
    skos:definition "값의 출처: 고정 어휘 — product·agent. 검증의 두 대상 구분 (0.5절, 7.8절)."@ko .

agt:levelCategory a owl:NamedIndividual , agt:TagCategory ;
    rdfs:label "level"@en , "수준"@ko ;
    skos:definition "값의 출처: 정제 계층의 다섯 개체. 예: level:logical (0.5절)."@ko .
