# 결함 — ODC 영향 차원 다섯. 위험 분석의 피해 목록이고 우선순위의 근거다 (노트 8.17절, 8.21절)
@prefix agt: <https://agentic-knowledge-base.dev/agt/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

agt:DefectImpact a owl:Class ;
    rdfs:label "defect impact"@en , "결함 영향"@ko ;
    skos:definition "결함이 무엇을 손상했는지를 가르는 차원. 이 도메인의 피해 목록이 이 차원의 값 다섯이므로 위험 분석은 피해를 새로 짓지 않는다 (8.17절, 8.21절, 유저 승인 2026-09-29)."@ko .

agt:functionalImpact a owl:NamedIndividual , agt:DefectImpact ;
    rdfs:label "functional impact"@en , "기능 영향"@ko ;
    skos:definition "지식이 틀려 하류 산출물이 틀린다. 피해 H1 이다 (8.21절)."@ko ;
    skos:notation "H1" .

agt:performanceImpact a owl:NamedIndividual , agt:DefectImpact ;
    rdfs:label "performance impact"@en , "성능 영향"@ko ;
    skos:definition "작업 집합이 예산을 넘겨 답을 완결하지 못한다. 피해 H2 다 (8.21절)."@ko ;
    skos:notation "H2" .

agt:traceabilityImpact a owl:NamedIndividual , agt:DefectImpact ;
    rdfs:label "traceability impact"@en , "추적성 영향"@ko ;
    skos:definition "산출물이 요구로 거슬러 오르지 못한다. 피해 H3 이다 (8.21절)."@ko ;
    skos:notation "H3" .

agt:assumptionSoundnessImpact a owl:NamedIndividual , agt:DefectImpact ;
    rdfs:label "assumption soundness impact"@en , "가정 건전성 영향"@ko ;
    skos:definition "전제가 깨졌는데 의존 지식이 그대로 쓰인다. 피해 H4 다 (8.21절)."@ko ;
    skos:notation "H4" .

agt:coverageImpact a owl:NamedIndividual , agt:DefectImpact ;
    rdfs:label "coverage impact"@en , "커버리지 영향"@ko ;
    skos:definition "검사는 통과했으나 실제로는 검증되지 않았다. 피해 H5 다 (8.21절)."@ko ;
    skos:notation "H5" .

agt:knowledgeLossImpact a owl:NamedIndividual , agt:DefectImpact ;
    rdfs:label "knowledge loss and reproduction"@en , "지식 유실·재생산"@ko ;
    skos:definition "있는 지식을 찾지 못해 다시 만든다. H1 의 하위다 — 잘못된 지식의 확산과 원인이 같고 ODC 영향 차원에 여섯째가 없다 (유저 승인 2026-09-29)."@ko ;
    skos:notation "H1.1" ;
    skos:broader agt:functionalImpact .
