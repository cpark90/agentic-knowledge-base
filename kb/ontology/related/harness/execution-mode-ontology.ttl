# 하네스 — 실행 모드: 세션 유지 / dispatch (노트 9.3절)
@prefix agt: <https://agentic-knowledge-base.dev/agt/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

agt:ExecutionMode a owl:Class ;
    rdfs:label "execution mode"@en , "실행 모드"@ko ;
    skos:definition "세션 유지 / dispatch. 하네스 구성의 입력 (9.3절)."@ko .

agt:dispatch a owl:NamedIndividual , agt:ExecutionMode ;
    rdfs:label "dispatch"@en , "디스패치"@ko ;
    skos:definition "깨끗한 컨텍스트로 위임. 대상에게는 역할 스코프로 거른 situation만 전달한다 (9.3절)."@ko .

agt:sessionPersistent a owl:NamedIndividual , agt:ExecutionMode ;
    rdfs:label "session persistent"@en , "세션 유지"@ko ;
    skos:definition "누적 지식을 보존하는 모드. memory plane 승격 규칙으로 주기적으로 비운다 (9.3절)."@ko .

agt:executionMode a owl:ObjectProperty ;
    rdfs:domain agt:Role ;
    rdfs:range agt:ExecutionMode ;
    rdfs:label "has execution mode"@en , "실행 모드를 갖는다"@ko ;
    skos:definition "역할의 구동 방식 (9.3절, 9.5절)."@ko .
