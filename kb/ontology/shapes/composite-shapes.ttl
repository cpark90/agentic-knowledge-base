# shape — 복합체: 7±2 인지 한계 (노트 4.5절)
@prefix agt: <https://agentic-knowledge-base.dev/agt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

agt:CompositeShape a sh:NodeShape ;
    sh:targetClass agt:Composite ;
    sh:property [
        sh:path agt:hasDirectPart ;
        sh:maxCount 9 ;
        sh:message "직접 부분은 최대 9개(7±2)다 (4.5절)" ;
    ] .
