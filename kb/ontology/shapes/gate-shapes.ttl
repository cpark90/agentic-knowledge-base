# shape — 게이트: 개체마다 서비스 층 하나와 실행 계층 하나가 필수다 (gate-ontology, 결정 p0-service-is-a-three-layer-wiki)
# 서비스 층과 실행 계층의 값은 닫힌 집합이라 sh:class 가 아니라 sh:in 으로 판정한다 — rdfs:range 의 함의는 지어낸 IRI 를 통과시킨다.
# 게이트는 전부 프로세스 층이므로 층의 sh:in 은 원소 하나다. 라벨은 한/영 각 하나이고 설명 한 줄이 필수다.
@prefix agt: <https://agentic-knowledge-base.dev/agt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

agt:GateShape a sh:NodeShape ;
    sh:targetClass agt:Gate ;
    sh:property [
        sh:path agt:inLayer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( agt:processLayer ) ;
        sh:message "게이트는 프로세스 층의 항목이다 — 판정 표면이 그 층의 실물이다 (p0-service-is-a-three-layer-wiki)" ;
    ] ;
    sh:property [
        sh:path agt:gateTier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( agt:shapeTier agt:verifyTier agt:analysisTier agt:testTier agt:humanTier ) ;
        sh:message "게이트의 실행 계층은 정확히 하나이고 shape | verify | analysis | test | human 중 하나다 (defs/kb.bzl 의 GATE_TIERS)" ;
    ] ;
    sh:property [
        sh:path agt:enforcedBy ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "강제하는 도구는 하나다 — 파이썬 밖(Starlark·Bazel)인 게이트는 가리킬 코드 청크가 없어 이 술어가 없다" ;
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 1 ;
        sh:message "게이트마다 무엇을 거부하는가 한 줄이 필수다 (defs/kb.bzl 의 GATES 에 적는 desc)" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:message "라벨은 한/영 각 하나다 — 라벨만 보고 무엇을 거부하는지 예측할 수 있어야 한다 (d-0082)" ;
    ] .
