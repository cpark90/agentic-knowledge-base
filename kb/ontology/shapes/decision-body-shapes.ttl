# shape — 설계 결정의 본문 틀 셋: 결론·근거·대안. 세 청크 규칙(kb_decision)이 이미 강제하는 형태를 슬롯 질문과 함께 기술한다 (결정 p4-slot-answers-one-question)
# 옛 단일 파일 결정(chunks/decision/d-*.md)은 한 파일이 결론과 근거를 함께 담으므로 sh:xone 이 아니라 sh:or 다 — 2026-09-22 실측에서 156건이 둘 이상을 만족했다.
# 슬롯 표지의 값은 xsd:string 이다 — 형이 없으면 언어 태그가 붙은 리터럴이나 IRI 가 슬롯 표지로 통과한다 (M5 값의 형, 2026-09-26).
@prefix agt: <https://agentic-knowledge-base.dev/agt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# V&V 시나리오도 decision plane 이라 같은 틀에 든다 (결정 p8-scenario-authoring) — 표지 낱말만 자극·요인·배제 자극으로 갈리고
# 슬롯은 결정의 결론·근거·대안 그대로다. 그래서 새 틀이 아니라 이 sh:or 의 대안 셋이다. 파일명과 표지의 대응
# (`-stimulus` 자극 · `-factors` 요인 · `-excluded` 배제 자극)은 게이트 `decision-role`(chunk_lint)이 본다 — shape 는 노드만 보고
# 파일 stem 을 모른다. 단일 청크 시나리오(이행기)는 **결론** 표지로 첫 대안을 만족한다.
agt:DecisionBodyShape a sh:NodeShape ;
    sh:targetClass agt:DesignDecision ;
    sh:or ( agt:DecisionConclusionBodyShape agt:DecisionRationaleBodyShape agt:DecisionAlternativesBodyShape
            agt:DecisionConventionsBodyShape
            agt:ScenarioStimulusBodyShape agt:ScenarioFactorsBodyShape agt:ScenarioExcludedBodyShape ) ;
    sh:message "설계 결정의 본문은 역할 표지 **결론**·**근거**·**대안**·**규약**(V&V 시나리오는 **자극**·**요인**·**배제 자극**) 중 하나로 시작해야 한다 — 세 청크와 선택 규약 청크가 한 결정을 이룬다 (p7-dev-plane-substance, p4-slot-answers-one-question, p8-scenario-authoring, p4-convention-slot)" .

agt:ScenarioStimulusBodyShape a sh:NodeShape ;
    sh:property [ sh:path agt:bodySlot ; sh:datatype xsd:string ; sh:hasValue "자극" ; sh:order 1 ;
        sh:description "무엇을 자극하는가 (결정의 결론 자리)" ;
        sh:message "슬롯 **자극** 이 없다 — actor·action·순서·`keep()` 를 적고 요인·배제 자극은 형제 청크에 둔다" ] .

agt:ScenarioFactorsBodyShape a sh:NodeShape ;
    sh:property [ sh:path agt:bodySlot ; sh:datatype xsd:string ; sh:hasValue "요인" ; sh:order 1 ;
        sh:description "무엇을 노출하려 그렇게 자극하는가 (결정의 근거 자리)" ;
        sh:message "슬롯 **요인** 이 없다 — 노출하려는 결함 요인과 기여하는 검증 목표를 적는다" ] .

agt:ScenarioExcludedBodyShape a sh:NodeShape ;
    sh:property [ sh:path agt:bodySlot ; sh:datatype xsd:string ; sh:hasValue "배제 자극" ; sh:order 1 ;
        sh:description "무엇을 자극하지 않기로 했고 왜 그런가 (결정의 대안 자리)" ;
        sh:message "슬롯 **배제 자극** 이 없다 — 다루지 않기로 한 자극과 이유(ODD 밖·다른 시나리오가 덮음)를 적는다" ] .

agt:DecisionConclusionBodyShape a sh:NodeShape ;
    sh:property [ sh:path agt:bodySlot ; sh:datatype xsd:string ; sh:hasValue "결론" ; sh:order 1 ;
        sh:description "무엇을 정했는가" ;
        sh:message "슬롯 **결론** 이 없다 — 정한 것을 한 문장으로 적고 근거·대안은 형제 청크에 둔다" ] .

agt:DecisionRationaleBodyShape a sh:NodeShape ;
    sh:property [ sh:path agt:bodySlot ; sh:datatype xsd:string ; sh:hasValue "근거" ; sh:order 1 ;
        sh:description "왜 그렇게 정했는가" ;
        sh:message "슬롯 **근거** 가 없다 — 결론을 지지하는 까닭을 적는다" ] .

agt:DecisionAlternativesBodyShape a sh:NodeShape ;
    sh:property [ sh:path agt:bodySlot ; sh:datatype xsd:string ; sh:hasValue "대안" ; sh:order 1 ;
        sh:description "무엇을 기각했고 왜 기각했는가" ;
        sh:message "슬롯 **대안** 이 없다 — 기각한 안과 기각 사유를 적고, 없으면 **대안 없음** 으로 적는다" ] .

agt:DecisionConventionsBodyShape a sh:NodeShape ;
    sh:property [ sh:path agt:bodySlot ; sh:datatype xsd:string ; sh:hasValue "규약" ; sh:order 1 ;
        sh:description "이 결정이 규범 문서에 싣는 문장은 무엇인가 (선택 넷째 청크 conventions.md)" ;
        sh:message "슬롯 **규약** 이 없다 — 첫 줄 `**규약** — …` 뒤에 줄마다 `규약: [지킴] …`·`규약: [권장] …`·`규약: …` 을 적는다 (p4-convention-slot)" ] .
