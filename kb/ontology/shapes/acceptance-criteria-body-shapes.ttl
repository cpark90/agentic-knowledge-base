# shape — 합격 기준의 본문 틀: 기준 · 판정 · 등급 (kb/vv/criteria). 슬롯마다 등록 질문 하나 (결정 p4-slot-answers-one-question)
# 가운데 슬롯은 둘 중 하나다 — 기계가 판정하면 **판정식**, 사람이 확인하면 **확인 절차** 다. 2026-09-22 실측은 판정식 28·확인 절차 5 다.
# 슬롯 표지의 값은 xsd:string 이다 — 형이 없으면 언어 태그가 붙은 리터럴이나 IRI 가 슬롯 표지로 통과한다 (M5 값의 형, 2026-09-26).
@prefix agt: <https://agentic-knowledge-base.dev/agt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

agt:AcceptanceCriteriaBodyShape a sh:NodeShape ;
    sh:targetClass agt:InterfaceSignature ;
    sh:property [ sh:path agt:bodySlot ; sh:datatype xsd:string ; sh:hasValue "합격 기준" ; sh:order 1 ;
        sh:description "어떤 조건이 성립해야 합격인가" ;
        sh:message "첫 슬롯 **합격 기준** 이 없다 — 기준 종류와 성립 조건을 한 문장으로 적는다" ] ;
    sh:or ( agt:CriteriaFormulaBodyShape agt:CriteriaProcedureBodyShape ) ;
    sh:property [ sh:path agt:bodySlot ; sh:datatype xsd:string ; sh:hasValue "등급" ; sh:order 3 ;
        sh:description "이 판정을 얼마나 믿을 수 있는가" ;
        sh:message "슬롯 **등급** 이 없다 — 판정 등급과 그 까닭을 적는다" ] ;
    sh:message "합격 기준의 본문은 **합격 기준** · (**판정식** 또는 **확인 절차**) · **등급** 순이어야 한다 (p4-slot-answers-one-question)" .

agt:CriteriaFormulaBodyShape a sh:NodeShape ;
    sh:property [ sh:path agt:bodySlot ; sh:datatype xsd:string ; sh:hasValue "판정식" ; sh:order 2 ;
        sh:description "기계는 그 조건을 어떤 식으로 판정하는가" ;
        sh:message "슬롯 **판정식** 이 없다 — 음성·양성 판정을 실행 가능한 식으로 적는다" ] .

agt:CriteriaProcedureBodyShape a sh:NodeShape ;
    sh:property [ sh:path agt:bodySlot ; sh:datatype xsd:string ; sh:hasValue "확인 절차" ; sh:order 2 ;
        sh:description "사람은 그 조건을 어떤 순서로 확인하는가" ;
        sh:message "슬롯 **확인 절차** 가 없다 — 사람이 따라갈 순서를 적는다. 기계 판정이면 **판정식** 을 쓴다" ] .
