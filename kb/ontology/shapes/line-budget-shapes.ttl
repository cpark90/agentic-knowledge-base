# shape — 본문 줄 수의 상한: plane 별 프로파일 파라미터 (p7-code-extraction-direction "예산", 유저 승인 2026-09-30)
@prefix agt: <https://agentic-knowledge-base.dev/agt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# 본문 줄 수의 상한은 **plane 별 프로파일 파라미터**다 (p7-code-extraction-direction "예산", 유저 승인 2026-09-30).
# 값의 단일 정의처는 tools/kb_lib.py 의 BODY_LINE_LIMITS 이고 게이트 chunk_lint 가 같은 표를 읽는다 — 여기는 그래프 쪽
# 강제다. 42줄은 **저작된 산문**의 예산(4.1절, d-0002)이고 `artifact` 의 본문은 저작이 아니라 소스의 인용이라 그 예산이
# 인위적 분할을 부른다. 200 은 42줄의 근거가 된 컨텍스트 한계 그 자체다 — 청크 하나가 컨텍스트 한 창을 넘지 않는다.
agt:RequirementLineBudgetShape a sh:NodeShape ;
    sh:targetClass agt:RequirementChunk ;
    sh:property [ sh:path agt:lineCount ; sh:maxInclusive 42 ; sh:message "본문은 42줄 이하여야 한다 (4.1절)" ] .

agt:DecisionLineBudgetShape a sh:NodeShape ;
    sh:targetClass agt:DecisionChunk ;
    sh:property [ sh:path agt:lineCount ; sh:maxInclusive 42 ; sh:message "본문은 42줄 이하여야 한다 (4.1절)" ] .

agt:ContractLineBudgetShape a sh:NodeShape ;
    sh:targetClass agt:ContractChunk ;
    sh:property [ sh:path agt:lineCount ; sh:maxInclusive 42 ; sh:message "본문은 42줄 이하여야 한다 (4.1절)" ] .

agt:SchemaLineBudgetShape a sh:NodeShape ;
    sh:targetClass agt:SchemaChunk ;
    sh:property [ sh:path agt:lineCount ; sh:maxInclusive 42 ; sh:message "본문은 42줄 이하여야 한다 (4.1절)" ] .

agt:AnnotationLineBudgetShape a sh:NodeShape ;
    sh:targetClass agt:AnnotationChunk ;
    sh:property [ sh:path agt:lineCount ; sh:maxInclusive 42 ; sh:message "본문은 42줄 이하여야 한다 (4.1절)" ] .

agt:MemoryLineBudgetShape a sh:NodeShape ;
    sh:targetClass agt:MemoryChunk ;
    sh:property [ sh:path agt:lineCount ; sh:maxInclusive 42 ; sh:message "본문은 42줄 이하여야 한다 (4.1절)" ] .

agt:ArtifactLineBudgetShape a sh:NodeShape ;
    sh:targetClass agt:ArtifactChunk ;
    sh:property [ sh:path agt:lineCount ; sh:maxInclusive 200 ;
        sh:message "artifact 청크의 본문은 200줄 이하여야 한다 — 상한은 plane 별 프로파일 파라미터이고 정의처는 tools/kb_lib.py 의 BODY_LINE_LIMITS 다 (p7-code-extraction-direction)" ] .
