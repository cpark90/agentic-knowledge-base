# 생성 파일 — 손으로 고치지 않는다. 원본은 각 청크의 frontmatter (tools/gen_build.py). 검사: //:build_drift_test

load("//defs:knowledge.bzl", "kb_chunk_lint_test")

# V&V KB — 시나리오 기반 확인의 지식 (노트 7.1절). 개발 KB 와 같은 코어의 두 번째 인스턴스 (p8-vv-plane-instances): 디렉토리 = plane.
# 편집은 vnv 만(kg/catalog-kg.ttl agt:writesIn "kb/vv"), 개발 역할은 읽기만. verifies 링크만 KB 를 가로지른다 (V&V → 개발, 같은 level).
package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "bodies",
    srcs = [
        "//kb/vv/case:bodies",
        "//kb/vv/criteria:bodies",
        "//kb/vv/goal:bodies",
        "//kb/vv/run:bodies",
        "//kb/vv/scenario:bodies",
        "//kb/vv/verifier:bodies",
    ] + glob(
        ["*.md"],
        allow_empty = True,
    ),
)

kb_chunk_lint_test(
    name = "lint_test",
    chunks = [":bodies"],
    waivers = "//docs:waivers",  # prose 면제 선언 (docs/waivers.md)
)
