# 규범 문서 생성기의 고정물 (p12-norm-documents-from-section-chunks) — 가짜 트리 하나(norm/): 결정 둘 · 절 청크 열(그 둘은 묶음
# 복합체 하나, p4-composite-as-part-of. 하나는 번호 없는 절 numbered: false) · 둘째 문서의 절 청크 둘(fy/) · 생성 결과 FX.md·FY.md.
# FY.md 는 FX.md 가 싣는 줄 하나를 다시 싣는다 — 서로 다른 문서의 공유는 양성이고 한 문서 안의 이중 소비만 음성이다.
# 양성은 트리의 FX.md 가 재생성과 바이트로 같은지(표 절 둘 · 순서 목록 절 · 이어짐 절 둘 포함), 음성 여덟은 복사본 한 곳을 바꿔
# 고아 줄 · 한 문서 안의 이중 소비 · 강도 없음 · depth 3 절의 numbered · 표의 칸 수 불일치 · 마지막이 아닌 link_column · 표 줄의 강도 ·
# 첫 절의 continues 가 거부되는지 본다.
# writer 는 카탈로그로 절 청크의 쓰기 권한(orchestrator 통과 · developer 거부)을 본다
filegroup(
    name = "norm_fixture",
    srcs = glob(["norm/**"]),
)

[kb_norms_fixture_test(
    name = "norms_fixture_%s_test" % case,
    case = case,
    fixture = ":norm_fixture",
    src = "norm_fixture_test.py",
) for case in [
    "ok",
    "orphan",
    "double",
    "weak",
    "numbered",
    "cells",
    "linkcol",
    "tablestrength",
    "firstcont",
    "writer",
]]

# 고정물의 생성 결과도 생성 문서 규약 G1~G18 안이다 — 링크(G13)는 출력 위치 기준으로 다시 계산된 경로로 실재해야 한다
kb_gendoc_test(
    name = "norms_fixture_gendoc_test",
    data = [":norm_fixture"],
    docs = [
        "norm/FX.md",
        "norm/FY.md",
    ],
)

# 결정의 넷째 부분 — 규약 청크 conventions.md 가 있으면 kb_decision 이 부분 넷을 순서 결론·근거·대안·규약으로 받는다 (p4-convention-slot)
kb_decision(
    name = "fx_decision_conventions",
    alternatives = "norm/kb/dev/decision/fx-a/alternatives.md",
    conclusion = "norm/kb/dev/decision/fx-a/conclusion.md",
    conventions = "norm/kb/dev/decision/fx-a/conventions.md",
    iri = "urn:fx:norm:a",
    ordered = ["urn:fx:norm:a-c", "urn:fx:norm:a-r", "urn:fx:norm:a-a", "urn:fx:norm:a-v"],
    part_iris = ["urn:fx:norm:a-c", "urn:fx:norm:a-r", "urn:fx:norm:a-a", "urn:fx:norm:a-v"],
    part_levels = ["concrete", "logical", "logical", "concrete"],
    rationale = "norm/kb/dev/decision/fx-a/rationale.md",
    status = "draft",
    tags = ["manual"],
)

# 규범 문서의 복합체 — 절 청크가 줄을 싣는 결정으로 agt:projectsConvention 을, 절 키로 제목·깊이를 낸다
kb_composite(
    name = "fx_norm_doc",
    srcs = glob(["norm/kb/dev/norm/fx/*.md"]),
    conventions = {"fx-a": "urn:fx:norm:a"},
    iri = "urn:fx:norm:doc",
    level = "logical",
    ordered = ["urn:fx:norm:head", "urn:fx:norm:one", "urn:fx:norm:two", "urn:fx:norm:five", "urn:fx:norm:grp",
               "urn:fx:norm:six", "urn:fx:norm:seven", "urn:fx:norm:eight", "urn:fx:norm:nine"],
    part_iris = ["urn:fx:norm:head", "urn:fx:norm:one", "urn:fx:norm:two", "urn:fx:norm:five", "urn:fx:norm:grp",
                 "urn:fx:norm:six", "urn:fx:norm:seven", "urn:fx:norm:eight", "urn:fx:norm:nine"],
    plane = "norm",
    status = "draft",
    tags = ["manual"],
)

filegroup(
    name = "fx_norm_heads",
    srcs = [
        ":fx_decision_conventions",
        ":fx_norm_doc",
    ],
    output_group = "kg",
    tags = ["manual"],
)

genrule(
    name = "norm_heads",
    srcs = [":fx_norm_heads"],
    outs = ["norm_heads.ok"],
    cmd = "cat $(locations :fx_norm_heads) > $@ && " +
          "grep -q 'co:index \"4\"^^xsd:positiveInteger ; co:itemContent <urn:fx:norm:a-v>' $@ && " +
          "grep -q 'agt:projectsConvention <urn:fx:norm:a>' $@ && grep -q 'a agt:DocumentSectionChunk ;' $@ && " +
          "grep -q 'agt:sectionDepth 3' $@ && grep -q 'agt:sectionHeading \"공통\"' $@ && " +
          "grep -q 'co:index \"5\"^^xsd:positiveInteger ; co:itemContent <urn:fx:norm:grp>' $@ && " +
          "grep -q 'co:index \"2\"^^xsd:positiveInteger ; co:itemContent <urn:fx:norm:four>' $@ && " +
          "grep -q 'agt:sectionContinues true' $@",
    tags = ["manual"],
)

build_test(
    name = "norm_heads_positive_test",
    targets = [":norm_heads"],
)

# 케이스 생성기의 고정물 (p8-case-generation, 유저 답 Q27-a) — 가짜 V&V 트리 하나(case_gen/): logical 시나리오 자극 청크 하나(변수 셋 ·
# 다섯 규칙 · seed) · 관측 재현의 근거 실행 기록 · ODD 문서 · 커밋된 생성 케이스. 양성은 트리의 케이스가 재생성과 바이트로 같고
# 생성이 결정론적인지와 템플릿의 선택 키 `derivesFrom` 이 생성 케이스로 옮겨지는지, 음성은 복사본 한 곳을 바꿔 표본 근거 없는 케이스(규칙 없는 cover 항목 · 손으로 적은 값)와 드리프트·수기 케이스가
# 거부되는지 본다
filegroup(
    name = "case_gen_fixture",
    srcs = glob(["case_gen/**"]),
