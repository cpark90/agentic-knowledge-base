[kb_revalidate_fixture_test(
    name = "revalidate_fixture_%s_test" % case,
    case = case,
    fixture = ":revalidate_fixture",
    src = "revalidate_fixture_test.py",
) for case in [
    "dirs",
    "files",
    "same",
    "partial",
]]

# 검증 라운드 기록의 고정물 (유저 답 Q39-c) — `vv_run --round` 가 임시 트리에 라운드 기록을 쓰고, verify 질의 round-stop-rule-violated 가
# 최소 그래프에서 정지 규칙 위반을 잡거나(양성) 지킨 계열을 통과시키며(음성), audit 라운드 절이 기록으로 자르고 기록이 없으면 날짜 대리로
# 떨어지는지 본다. 허용 목록의 revalidate 스냅숏 꼴(유저 답 Q38-c)도 여기서 본다 — 실행기의 분류 함수가 판정 대상이다
[kb_round_fixture_test(
    name = "round_fixture_%s_test" % case,
    case = case,
    data = [
        "//kb/ontology/related/state",  # 종료 사유 온톨로지 모듈 (round-end-reason-ontology.ttl)
        "//tools:verify_queries",  # round-stop-rule-violated.rq
    ],
    src = "round_fixture_test.py",
) for case in [
    "record",
    "classify",
    "violated",
    "kept",
    "weave",
]]

# 생성 문서 머리 `입력` 줄의 union 증분 표기 (유저 답 Q40-a) — 고정물 그래프 셋을 시험이 TEST_TMPDIR 에 쓴다. 양성은 증분이 선언 순서대로
# 앞 구성원들의 합집합에 더한 수이고 합이 총수와 같아 G4 FAIL 이 없는 것, 음성은 총수 불일치 · 증분 없는 옛 표기 · 읽지 못한 구성원이다
py_test(
    name = "gendoc_union_fixture_test",
    size = "small",
    srcs = [
        "gendoc_union_fixture_test.py",
        "//tools:chunk2kg.py",
        "//tools:kb_lib.py",
    ],
    main = "gendoc_union_fixture_test.py",
    deps = [requirement("rdflib")],
)

# 복원 후보 생성기의 구조 거름 (orchestrator 판정 2026-10-04 — 기각 89 가운데 62가 구조상 채택될 수 없던 후보) — 양성은 정제 계층의
# 목표 → 요구 derivesFrom 이 남는 것(p8-scenario-ladder-rungs), 음성은 KB 가로지름(p6-executable-splits-by-kb) · 코드 부분 끝점
# (p7-code-links-on-file-composite) · 케이스의 derivesFrom(tools/case_gen.py)이 후보에서 빠지고 각자의 사유로 세어지는 것이다
py_test(
