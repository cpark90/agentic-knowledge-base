# 유저 피드백 채널 — 그래프 밖이지만 승인 규약은 게이트다 (유저 교정 2026-09-11):
# 반영 허가 = 유저의 status: approved 태깅뿐. 승인 없는 항목에 반영 흔적이 있으면 FAIL.
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

# 네 lane — 유저(./*.md) · agents/ · inquiries/ · handoff/(hci → 담당 역할, F). *.wip.md 는 작성 중이라 lint 가 건너뛴다
filegroup(
    name = "items",
    srcs = glob([
        "*.md",
        "agents/*.md",
        "inquiries/*.md",
        "handoff/*.md",
    ]),
)

# 면제는 코드가 아니라 //docs:waivers 의 선언으로 (게이트 id channel, 축 파일). 종료 코드 1 판정 / 2 설정 / 3 미실행
py_test(
    name = "channel_lint_test",
    srcs = ["//tools:channel_lint.py"],
    args = [
        "--waivers",
        "$(rootpath //docs:waivers)",
        "$(rootpaths :items)",
    ],
    data = [
        ":items",
        "//docs:waivers",
    ],
    main = "channel_lint.py",
    size = "small",
    deps = ["//tools:kb_lib"],
)
