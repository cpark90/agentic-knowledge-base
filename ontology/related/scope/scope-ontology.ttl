# 스코프 — 에이전트 접근 권한 (노트 0.4절, 3.4절)
@prefix agt: <https://agentic-knowledge-base.dev/agt/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

agt:Scope a owl:Class ;
    rdfs:label "scope"@en , "스코프"@ko ;
    skos:definition "에이전트의 접근 권한. ODD 속성의 부분집합 + plane 권한. mode / include / exclude / conditional 문장으로 쓴다 (0.4절, 3.4절)."@ko .

agt:subsetOf a owl:ObjectProperty ;
    rdfs:domain agt:Scope ;
    rdfs:range agt:ODD ;
    rdfs:label "subset of"@en , "부분집합이다"@ko ;
    skos:definition "스코프가 어느 ODD의 부분집합인지. ODD에 없는 속성을 참조하는 스코프는 존재할 수 없다 (0.4절)."@ko .

agt:includesCondition a owl:ObjectProperty ;
    rdfs:domain agt:Scope ;
    rdfs:range agt:Condition ;
    rdfs:label "includes condition"@en , "조건을 포함한다"@ko ;
    skos:definition "스코프 안에 있는 ODD 조건 (0.4절 include 문장)."@ko .

agt:excludesCondition a owl:ObjectProperty ;
    rdfs:domain agt:Scope ;
    rdfs:range agt:Condition ;
    rdfs:label "excludes condition"@en , "조건을 제외한다"@ko ;
    skos:definition "스코프 밖에 있는 ODD 조건 (0.4절 exclude 문장)."@ko .

agt:conditionalRule a owl:DatatypeProperty ;
    rdfs:domain agt:Scope ;
    rdfs:range xsd:string ;
    rdfs:label "conditional rule"@en , "조건부 규정"@ko ;
    skos:definition "include/exclude에 붙는 부가 조건. 'X이면 Y를 포함' 형태. 프로세스 규칙의 기계적 강제 지점 (0.4절, 9.1절)."@ko .
