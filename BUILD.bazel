load("//defs:knowledge.bzl", "kb_chunk_lint_test")

package(default_visibility = ["//visibility:public"])

# 산출물 접미사 규약 (노트 0.2절) — 저장소의 모든 TTL 산출물에 적용
kb_chunk_lint_test(
    name = "naming_test",
    ttl = [
        "//kg",
        "//kb/odd",
        "//kb/ontology:modules",
        "//kb/ontology:shapes",
    ],
)

# 게이트 전체 = 저장소의 모든 테스트. `bazel test //:gate` 또는 `bazel test //...`
test_suite(
    name = "gate",
    tests = [
        ":naming_test",
        "//chunks:lint_test",
        "//kg:gate_test",
        "//kb/odd:gate_test",
        "//kb/ontology:gate_test",
    ],
)
