load("@rules_python//python:defs.bzl", "py_test")
load("//defs:knowledge.bzl", "kb_chunk_lint_test")

package(default_visibility = ["//visibility:public"])

# 산출물 접미사 규약 (노트 0.2절) — 저장소의 모든 TTL 산출물에 적용
kb_chunk_lint_test(
    name = "naming_test",
    ttl = [
        "//kg",
        "//kb/odd",
        "//kb/ontology:modules",
        "//kb/ontology:shapes",
    ],
)

# 게이트 전체 = 저장소의 모든 테스트. `bazel test //:gate` 또는 `bazel test //...`
# BUILD 드리프트 가드 (d-0159): 생성기를 다시 돌려 커밋본과 비교 — frontmatter 가 원본, BUILD 는 뷰
py_test(
    name = "build_drift_test",
    srcs = [
        "//tools:chunk2kg.py",
        "//tools:gen_build.py",
    ],
    args = [
        "--check",
        "--root",
        ".",
    ],
    data = [
        "//chunks:bodies",
        "//chunks/decision:BUILD.bazel",
        "//kb/dev:bodies",
        "//kb/dev/decision:BUILD.bazel",
        "//kb/dev/requirement:BUILD.bazel",
        "//kb/ontology:modules",
        "//kb/ontology:modules.bzl",
        "//kb/ontology:module_builds",
    ],
    main = "gen_build.py",
    size = "small",
)

test_suite(
    name = "gate",
    tests = [
        ":build_drift_test",
        ":naming_test",
        "//docs/feedback:channel_lint_test",
        "//kg:kg_equivalence_test",
        "//chunks:lint_test",
        "//kg:gate_test",
        "//kb/odd:gate_test",
        "//kb/ontology:gate_test",
    ],
)
