load("@rules_python//python:defs.bzl", "py_test")
load("//defs:knowledge.bzl", "kb_chunk_lint_test", "kb_doccheck_test")

package(default_visibility = ["//visibility:public"])

# 산출물 접미사 규약 (노트 0.2절) — 저장소의 모든 TTL 산출물에 적용
kb_chunk_lint_test(
    name = "naming_test",
    ttl = [
        "//kg",
        "//kb/odd",
        "//kb/ontology:modules",
        "//kb/ontology:shapes",
    ],
)

# 문서 현행성 (agrtls-practices-review N): 진입점 문서의 죽은 링크·앵커·백틱 경로.
# glob 은 패키지 경계를 넘지 않는다 — docs/*.md·docs/open-questions/*.md 는 //docs 의 filegroup 으로 srcs 에 넣어야 한다
# (docs/BUILD.bazel 소유: orchestrator). 채널(//docs/feedback:items)과 노트(//docs:notes)는 대상으로만 쓴다.
# 실재 판정은 runfiles 이므로 문서가 가리키는 패키지의 파일은 targets 에 선언한다.
kb_doccheck_test(
    name = "doccheck_test",
    srcs = glob(["*.md"]) + ["//docs:docs"],
    data = [
        "//defs:kb.bzl",
        "//defs:knowledge.bzl",
        "//kb/ontology:proposals",
        "//docs:glossary",
        "//docs/feedback:items",
        "//tools",
        "//chunks:bodies",
        "//kb/dev:bodies",
        "//kb/vv:bodies",
        "//kb/ontology:modules",
        "//kb/ontology:shapes",
        "//kb/ontology:modules.bzl",
        "//kg",
        "//kb/odd:project-odd.yml",
    ] + glob([".claude/**"]),
    empty_dirs = [
        "kb/vv",  # V&V KB — 7단계까지 비어 있다
        "space",  # 설계 공간 — 5단계까지 자리만
    ],
    target_only = ["//docs:notes"],
)

# 게이트 전체 = 저장소의 모든 테스트. `bazel test //:gate` 또는 `bazel test //...`
# BUILD 드리프트 가드 (d-0159): 생성기를 다시 돌려 커밋본과 비교 — frontmatter 가 원본, BUILD 는 뷰
py_test(
    name = "build_drift_test",
    srcs = [
        "//tools:chunk2kg.py",
        "//tools:gen_build.py",
    ],
    args = [
        "--check",
        "--root",
        ".",
    ],
    data = [
        "//chunks:bodies",
        "//chunks/decision:BUILD.bazel",
        "//kb/dev:bodies",
        "//kb/dev/decision:BUILD.bazel",
        "//kb/dev/requirement:BUILD.bazel",
        "//kb/ontology:modules",
        "//kb/ontology:modules.bzl",
        "//kb/ontology:module_builds",
    ],
    main = "gen_build.py",
    size = "small",
)

test_suite(
    name = "gate",
    tests = [
        ":build_drift_test",
        ":naming_test",
        "//docs/feedback:channel_lint_test",
        "//kg:kg_equivalence_test",
        "//chunks:lint_test",
        "//kg:gate_test",
        "//kb/odd:gate_test",
        "//kb/ontology:gate_test",
    ],
)
