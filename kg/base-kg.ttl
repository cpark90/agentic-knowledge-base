# base-kg — 지식그래프 A-Box 시드: 청크가 아닌 개체(가정·출처 문서).
# 청크의 head 그래프는 손으로 쓰지 않는다 — 한 청크는 한 파일이고(chunks/),
# head는 각 청크 파일의 frontmatter에서 //kg:chunks_kg 가 생성한다 (노트 4.3절, 4.9절).
@prefix agt: <https://agentic-knowledge-base.dev/agt/> .
@prefix id: <https://agentic-knowledge-base.dev/id/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

### 가정 (0.4절 — ODD 조건 위의 명제)

id:asm-bazel-toolchain a agt:Assumption ;
    rdfs:label "Bazel toolchain available"@en , "Bazel 툴체인 가용"@ko ;
    agt:proposition "빌드 체계 조건이 성립한다 — Bazel 9.2.0 + bzlmod 로 bazel test //... 가 성공한다" ;
    agt:refersTo id:cond-build-system .

# 기본 가정 — 항목 고유의 전제를 아직 적지 않은 청크의 자리표시. 좁힘(항목별 가정)이 이것을 대체한다
# (dependency-graph-design §6 "기본 가정 후 좁힘", 유저 수용 2026-09-12)
id:asm-chunk-conventions a agt:Assumption ;
    rdfs:label "chunk conventions hold"@en , "청크 규약 성립"@ko ;
    agt:proposition "저장소 구조 조건(파일 = 청크, 디렉토리 = 모듈, 부록 E.7 배치)과 언어 정책 조건(산문 한글, 식별자 영어, 라벨 한/영 1:1)이 성립한다 — 둘 중 하나가 깨지면 청크의 IRI↔파일 해석과 라벨 인터페이스가 무효다" ;
    agt:refersTo id:cond-repo-layout , id:cond-language-policy .

# 판정자(게이트 밖 도구)의 전제 — 판정 로그·결과 주석이 assumes 로 참조한다. 조건이 이탈하면 지난 판정이 suspect 로 전파된다 (2026-09-29).
id:asm-judge-service a agt:Assumption ;
    rdfs:label "judge service credentials and model are set together"@en , "판정 서비스의 자격과 모델이 함께 설정돼 있다"@ko ;
    agt:proposition "판정 서비스 조건이 성립한다 — 환경 변수 셋(AKB_JUDGE_ENDPOINT·AKB_JUDGE_API_KEY·AKB_JUDGE_MODEL)이 함께 설정돼 있고 로그의 모델 식별자가 캘리브레이션 표본의 모델과 같다. 깨지면 그 모델로 낸 판정의 확신도가 뜻을 잃는다" ;
    agt:refersTo id:cond-judge-service .

# V&V 프로파일의 규칙성 가정 셋 — 위험 분석 G1~G6 의 전제 (유저 승인 2026-09-29, 항목 vv-profile-hazards).
# 프로파일에서 파생되는 kb/vv/ 청크가 assumes: 로 이것을 참조하는 것이 등록이다. A3 은 참조 저장소가 반증한 형태에서 뽑았다.
id:asm-links-only-interaction a agt:Assumption ;
    rdfs:label "knowledge items interact only through links"@en , "지식 항목은 링크로만 상호작용한다"@ko ;
    agt:proposition "지식 항목은 frontmatter 의 링크로만 상호작용한다 — 본문만 읽고 생기는 의존은 후보 링크(//kg:link_candidates)로 드러난다. 거짓이면 영향 집합 계산이 실제 의존을 놓친다" ;
    agt:refersTo id:cond-repo-layout .

id:asm-finite-factor-types a agt:Assumption ;
    rdfs:label "failures surface as finitely many factor types"@en , "실패는 유한한 요인 유형으로 드러난다"@ko ;
    agt:proposition "실패는 유한한 요인 유형으로 드러나고 그 유형은 생성물(지표·감사·게이트)에서 관측된다. 거짓이면 현상 목록의 관측 수단이 닫히지 않는다" ;
    agt:refersTo id:cond-build-system .

id:asm-missing-vocabulary-is-signal a agt:Assumption ;
    rdfs:label "an element without vocabulary is an extension signal"@en , "어휘 없는 요소는 확장 신호다"@ko ;
    agt:proposition "어휘가 없는 요소는 건너뛸 것이 아니라 어휘 확장 신호다. 거짓이면 G1 의 현상 목록이 영원히 불완전하다 — 참조 저장소 R1·R3 이 반증한 형태(어휘 없는 요소를 건너뛴 결과)에서 뽑았다" ;
    agt:refersTo id:cond-language-policy ;
    prov:wasDerivedFrom id:doc-harness-ontology .

### 출처 문서 — 내용을 청크로 승격해 가져오는 원천 (prov:wasDerivedFrom 의 대상)

