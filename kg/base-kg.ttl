# base-kg — 지식그래프 A-Box 시드: 청크가 아닌 개체(가정·출처 문서).
# 청크의 head 그래프는 손으로 쓰지 않는다 — 한 청크는 한 파일이고(chunks/),
# head는 각 청크 파일의 frontmatter에서 //kg:chunks_kg 가 생성한다 (노트 4.3절, 4.9절).
@prefix agt: <https://agentic-knowledge-base.dev/agt/> .
@prefix id: <https://agentic-knowledge-base.dev/id/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

### 가정 (0.4절 — ODD 조건 위의 명제)

id:asm-bazel-toolchain a agt:Assumption ;
    rdfs:label "Bazel toolchain available"@en , "Bazel 툴체인 가용"@ko ;
    agt:proposition "빌드 체계 조건이 성립한다 — Bazel 9.2.0 + bzlmod 로 bazel test //... 가 성공한다" ;
    agt:refersTo id:cond-build-system .

# 기본 가정 — 항목 고유의 전제를 아직 적지 않은 청크의 자리표시. 좁힘(항목별 가정)이 이것을 대체한다
# (dependency-graph-design §6 "기본 가정 후 좁힘", 유저 수용 2026-09-12)
id:asm-chunk-conventions a agt:Assumption ;
    rdfs:label "chunk conventions hold"@en , "청크 규약 성립"@ko ;
    agt:proposition "저장소 구조 조건(파일 = 청크, 디렉토리 = 모듈, 부록 E.7 배치)과 언어 정책 조건(산문 한글, 식별자 영어, 라벨 한/영 1:1)이 성립한다 — 둘 중 하나가 깨지면 청크의 IRI↔파일 해석과 라벨 인터페이스가 무효다" ;
    agt:refersTo id:cond-repo-layout , id:cond-language-policy .

### 출처 문서 — 내용을 청크로 승격해 가져오는 원천 (prov:wasDerivedFrom 의 대상)

# v1은 2026-09-01 분해 후 제거되었으나(git ed633cc), v3(2,789줄)가 2026-09-08 돌아왔다.
# IRI는 유지한다 (0.7절 지속 IRI) — v1 유래 결정과 v3 유래 항목이 같은 원천을 가리킨다.
id:doc-system-notes
    rdfs:label "agent knowledge system design notes (v3)"@en ,
        "에이전트 지식 관리 체계 설계 노트 (v3)"@ko ;
    prov:atLocation "docs/agent-knowledge-system-notes.md" .

id:doc-structure
    rdfs:label "agentic knowledge base structure map (v3)"@en ,
        "Agentic Knowledge Base 구조도 (v3)"@ko ;
    prov:atLocation "docs/agentic-knowledge-base-structure.md" .

# 지속 IRI 원칙(0.7절): 저장소가 개명되어도 출처 개체의 IRI는 유지한다.
id:doc-harness-ontology
    rdfs:label "harness functional repository (formerly harness_ontology)"@en ,
        "하네스 functional 저장소 (구 harness_ontology)"@ko ;
    prov:atLocation "../harness-functional" .

id:doc-harness-recipes
    rdfs:label "harness concrete repository (formerly harness-recipes)"@en ,
        "하네스 concrete 저장소 (구 harness-recipes)"@ko ;
    prov:atLocation "../harness-concrete" .

# 유저 결정의 원문 — 채널 항목이 결정의 출처가 될 때 (docs/feedback/README.md)
id:doc-label-representativeness-protocol
    rdfs:label "label representativeness protocol (user feedback item)"@en ,
        "라벨 대표성 실험 프로토콜 (유저 피드백 항목)"@ko ;
    prov:atLocation "docs/feedback/label-representativeness-protocol.md" .

id:doc-dependency-graph-design
    rdfs:label "dependency graph design (user feedback item)"@en ,
        "의존성 그래프 설계 (유저 피드백 항목)"@ko ;
    prov:atLocation "docs/feedback/dependency-graph-design.md" .
