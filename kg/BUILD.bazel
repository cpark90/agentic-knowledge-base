load("@rules_python//python:defs.bzl", "py_test")
load("//defs:kb.bzl", "kb_kg_merge", "kb_workset_view")
load("//defs:knowledge.bzl", "kb_chunk_kg", "kb_gate_test", "kb_metrics", "kb_reference_kg")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "kg",
    srcs = glob(["*-kg.ttl"]),
)

# 청크 head 그래프 — 타깃별 조각(KgInfo)의 병합 (4.3절, bazel-dependency-review 5단계). 바뀐 타깃의 조각만 다시 만들어진다.
kb_kg_merge(
    name = "chunks_kg",
    out = "chunks-kg.ttl",
    deps = [
        "//chunks/decision:kg",  # v1 결정 153 — 재도출 후 deprecated로 남는다
        "//kb/dev/decision:kg",
        "//kb/dev/requirement:kg",
    ],
)

# 같은 그래프를 옛 방식(union 한 번에)으로 — 병합 결과와 바이트 동일해야 한다 (d-0157 union 검증의 대조군)
kb_chunk_kg(
    name = "chunks_kg_union",
    srcs = [
        "//chunks:bodies",
        "//kb/dev:bodies",
        "//kb/vv:bodies",
    ],
    out = "chunks-kg-union.ttl",
)

py_test(
    name = "kg_equivalence_test",
    srcs = ["//tools:same_bytes.py"],
    args = [
        "$(rootpath :chunks_kg)",
        "$(rootpath :chunks_kg_union)",
    ],
    data = [
        ":chunks_kg",
        ":chunks_kg_union",
    ],
    main = "same_bytes.py",
    size = "small",
)

# 참조 링크 — 본문의 인용에서 생성 (8.2절). 손으로 쓰지 않는다.
kb_reference_kg(
    name = "references_kg",
    srcs = [
        "//chunks:bodies",
        "//kb/dev:bodies",
        "//kb/vv:bodies",
    ],
    out = "references-kg.ttl",
)

# 지식그래프 게이트: 통제 어휘(4.4절) + 청크 shape + 가정→ODD 참조(0.4절)
kb_gate_test(
    name = "gate_test",
    data = [
        ":chunks_kg",
        ":kg",
        ":references_kg",
    ],
    odd = ["//kb/odd:odd"],
    ontology = ["//kb/ontology:modules"],
    shapes = ["//kb/ontology:shapes"],
    verify_queries = "//tools:verify_queries",
)

# 코어 지표 — 생성물 (bazel build //kg:metrics → bazel-bin/kg/metrics.md). 4.13절·14.1절
kb_metrics(
    name = "metrics",
    bodies = ["//kb/dev:bodies"],
    data = [
        ":chunks_kg",
        ":kg",
        ":references_kg",
        "//kb/odd:odd",
    ],
    notes = "//docs:notes",
)

# 작업 집합 뷰 — 선택자는 빌드 설정: bazel build //kg:workset --//kb:role=developer --//kb:anchor="두 KB" --//kb:levels=concrete
kb_workset_view(
    name = "workset",
    data = [
        ":chunks_kg",
        ":kg",
        ":references_kg",
        "//kb/dev:bodies",
    ],
)
