load("//defs:kb.bzl", "kb_kg_merge", "kb_workset_view")
load("//defs:knowledge.bzl", "kb_community", "kb_cq_report", "kb_gate_test", "kb_link_candidates", "kb_metrics", "kb_open_questions", "kb_reference_kg", "kb_weave")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "kg",
    srcs = glob(["*-kg.ttl"]),
)

# 청크 head 그래프 — 타깃별 조각(KgInfo)의 병합 (4.3절, bazel-dependency-review 5단계). 바뀐 타깃의 조각만 다시 만들어진다.
kb_kg_merge(
    name = "chunks_kg",
    out = "chunks-kg.ttl",
    deps = [
        "//chunks/decision:kg",  # v1 결정 153 — 재도출 후 deprecated로 남는다
        "//kb/dev/decision:kg",
        "//kb/dev/memory:kg",  # 관측 (memory plane) — assume_check --record 의 생성물, gen_build 가 타깃으로 만든다
        "//kb/dev/requirement:kg",
        # V&V KB (7단계) — 디렉토리 = plane (pe-storage-layout), gen_build 가 타깃으로 만든다. 비어 있어도 된다
        "//kb/vv/case:kg",
        "//kb/vv/criteria:kg",
        "//kb/vv/goal:kg",
        "//kb/vv/run:kg",  # 실행 기록 (memory plane, append-only) — vv_run --record 의 생성물
        "//kb/vv/scenario:kg",
        "//kb/vv/verdict:kg",  # 판정 주석 (annotation plane) — 논평, p7-commentary-form
        "//kb/vv/verifier:kg",
    ],
)

# 참조 링크 — 본문의 인용에서 생성 (8.2절). 손으로 쓰지 않는다.
kb_reference_kg(
    name = "references_kg",
    srcs = [
        "//chunks:bodies",
        "//kb/dev:bodies",
        "//kb/vv:bodies",
    ],
    ontology = ["//kb/ontology:modules"],
    out = "references-kg.ttl",
)

# 지식그래프 게이트: 통제 어휘(4.4절) + 청크 shape + 가정→ODD 참조(0.4절) + 카탈로그 정합성(:kg 의 catalog-kg × //kb/odd:odd)
# + 설계 공간(//space:design_space 의 *-space) 의 규율 — 후보는 deps 가 아니므로 Bazel 이 로드 시점에 보지 못한다.
# 그 자리를 게이트 id `space`(validate check_space)가 대신한다 (결정 p9-candidate-storage, 요구 r-011)
kb_gate_test(
    name = "gate_test",
    data = [
        ":chunks_kg",
        ":kg",
        ":references_kg",
        "//space:design_space",
    ],
    odd = ["//kb/odd:odd"],
    ontology = ["//kb/ontology:modules"],
    shapes = ["//kb/ontology:shapes"],
    standard_vocab = ["@prov_o//file", "@skos//file"],
    verify_queries = "//tools:verify_queries",
)

# 코어 지표 — 생성물 (bazel build //kg:metrics → bazel-bin/kg/metrics.md). 4.13절·14.1절
kb_cq_report(
    name = "cq",
    data = [
        ":chunks_kg",
        ":kg",
        ":references_kg",
        "//kb/odd:odd",
        "//kb/ontology:modules",
    ],
    queries = "//tools:cq_queries",
)

kb_metrics(
    name = "metrics",
    bodies = ["//kb/dev:bodies"],
    data = [
        ":chunks_kg",
        ":kg",
        ":references_kg",
        "//kb/odd:odd",
    ],
    notes = "//docs:notes",
)

# 감사 보고서 (로드맵 8단계 "복원과 감사", 요구 audit-self-sufficiency) — 입력은 그래프 union 과 관측 청크(kb/vv/run/ 실행 기록 ·
# kb/dev/memory/ 가정 판정)뿐이다. 체계 밖 정보 0. bazel build //kg:audit → bazel-bin/kg/audit.md
kb_weave(
    name = "audit",
    bodies = [
        "//kb/vv:bodies",
        "//kb/dev:bodies",
    ],
    data = [
        ":chunks_kg",
        ":kg",
        ":references_kg",
        "//kb/odd:odd",
        "//kb/ontology:modules",
    ],
    kind = "audit",
)

# 커뮤니티 탐지 뷰 — 복합체 후보·relatedTo 링크 후보 (bazel build //kg:communities → bazel-bin/kg/communities.md). 채택은 사람
kb_community(
    name = "communities",
    data = [
        ":chunks_kg",
        ":kg",  # composite-kg 의 손으로 쓴 복합체 — 이미 복합체인 부분을 후보로 다시 내지 않기 위해
        ":references_kg",
    ],
)

# 복원 후보 생성기 뷰 (로드맵 8단계 복원) — frontmatter 링크가 없는 쌍의 후보를 체계 안 증거(cites · verifies 공동 커버 · usesConcept)로,
# 앵커당 k ≤ 7 (bazel build //kg:link_candidates → bazel-bin/kg/link-candidates.md). 확정은 사람이 앵커 청크의 restored: 로 — 게이트가 아니다
kb_link_candidates(
    name = "link_candidates",
    data = [
        ":chunks_kg",
        ":kg",  # composite-kg 의 손으로 쓴 복합체 — 형제끼리는 후보가 아니다
        ":references_kg",
    ],
)

# 작업 집합 뷰 — 선택자는 빌드 설정: bazel build //kg:workset --//kb:role=developer --//kb:anchor="두 KB" --//kb:levels=concrete
kb_workset_view(
    name = "workset",
    data = [
        ":chunks_kg",
        ":kg",
        ":references_kg",
        "//kb/dev:bodies",
        "//kb/vv:bodies",  # 앵커의 이웃에 V&V 항목이 있으면 본문을 펼친다 — 없으면 샌드박스에서 FileNotFoundError
    ],
)

# 미결 집계 뷰 — 청크의 선택 슬롯 `미확정:` 을 모은다 (p4-three-empty-values). 상세 다섯 절은 docs/open-questions.md 색인과
# 그 아래 문서로 남고 이 뷰는 집계만 맡는다. bazel build //kg:open → bazel-bin/kg/open.md
kb_open_questions(
    name = "open",
    bodies = [
        "//kb/dev:bodies",
        "//kb/vv:bodies",
    ],
    data = [":chunks_kg"],
)
