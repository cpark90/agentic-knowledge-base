load("//defs:knowledge.bzl", "kb_chunk_kg", "kb_gate_test", "kb_metrics", "kb_reference_kg")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "kg",
    srcs = glob(["*-kg.ttl"]),
)

# 청크 head 그래프 — 각 청크 파일의 frontmatter에서 생성 (4.3절). 손으로 쓰지 않는다.
kb_chunk_kg(
    name = "chunks_kg",
    srcs = [
        "//chunks:bodies",  # v1 결정 153 — 재도출 후 deprecated로 남는다
        "//kb/dev:bodies",
        "//kb/vv:bodies",
    ],
    out = "chunks-kg.ttl",
)

# 참조 링크 — 본문의 인용에서 생성 (8.2절). 손으로 쓰지 않는다.
kb_reference_kg(
    name = "references_kg",
    srcs = [
        "//chunks:bodies",
        "//kb/dev:bodies",
        "//kb/vv:bodies",
    ],
    out = "references-kg.ttl",
)

# 지식그래프 게이트: 어휘 폐쇄(4.4절) + 청크 shape + 가정→ODD 참조(0.4절)
kb_gate_test(
    name = "gate_test",
    data = [
        ":chunks_kg",
        ":kg",
        ":references_kg",
    ],
    odd = ["//kb/odd:odd"],
    ontology = ["//kb/ontology:modules"],
    shapes = ["//kb/ontology:shapes"],
    verify_queries = "//tools:verify_queries",
)

# 골격 지표 — 생성물 (bazel build //kg:metrics → bazel-bin/kg/metrics.md). 4.13절·14.1절
kb_metrics(
    name = "metrics",
    data = [
        ":chunks_kg",
        ":kg",
        ":references_kg",
    ],
)
