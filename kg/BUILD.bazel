load("//defs:kb.bzl", "EXTRACTED_SOURCES", "kb_kg_merge", "kb_workset_view")
load("//defs:knowledge.bzl", "kb_community", "kb_cq_report", "kb_gate_test", "kb_link_candidates", "kb_metrics", "kb_open_questions", "kb_reference_kg", "kb_weave")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "kg",
    srcs = glob(["*-kg.ttl"]),
)

# 청크 head 그래프 — 타깃별 조각(KgInfo)의 병합 (4.3절, bazel-dependency-review 5단계). 바뀐 타깃의 조각만 다시 만들어진다.
kb_kg_merge(
    name = "chunks_kg",
    out = "chunks-kg.ttl",
    deps = [
        "//chunks/decision:kg",  # v1 결정 153 — 재도출 후 deprecated로 남는다
        "//kb/dev/artifact:kg",  # 추출된 코드 청크 (artifact plane) — tools/extract.py 의 생성물, gen_build 가 타깃으로 만든다
        "//kb/dev/decision:kg",
        "//kb/dev/memory:kg",  # 관측 (memory plane) — assume_check --record 의 생성물, gen_build 가 타깃으로 만든다
        "//kb/dev/norm:kg",  # 규범 문서의 절 청크 (norm plane) — 문서마다 복합체 하나, gen_build 가 타깃으로 만든다
        "//kb/dev/requirement:kg",
        # V&V KB (7단계) — 디렉토리 = plane (pe-storage-layout), gen_build 가 타깃으로 만든다. 비어 있어도 된다
        "//kb/vv/case:kg",
        "//kb/vv/criteria:kg",
        "//kb/vv/goal:kg",
        "//kb/vv/run:kg",  # 실행 기록 (memory plane, append-only) — vv_run --record 의 생성물
        "//kb/vv/scenario:kg",
        "//kb/vv/verdict:kg",  # 판정 주석 (annotation plane) — 논평, p7-commentary-form
        "//kb/vv/verifier:kg",
    ],
)

# 게이트 그래프 — 게이트 등록부(//defs:kb.bzl 의 GATES)에서 생성 (M1 단일 정의처, 2026-10-02). 손으로 쓰지 않는다.
# 게이트는 프로세스 층의 **항목**이라 그래프에 개체가 서야 층별 집계(CQ-38)가 셀 자리를 갖는다
# (결정 p0-service-is-a-three-layer-wiki). agt:judgedBy 의 대상은 도구의 파일 복합체이므로 등록부 사이드카가 입력이다
genrule(
    name = "gates_kg",
    srcs = ["//defs:kb.bzl"] + ["//tools:" + mod + ".chunks.yml" for mod in EXTRACTED_SOURCES],
    outs = ["gates-kg.ttl"],
    cmd = "$(location //tools:gates2kg) --out $@ --gates $(location //defs:kb.bzl) --registry " +
          " ".join(["$(location //tools:%s.chunks.yml)" % mod for mod in EXTRACTED_SOURCES]),
    tools = ["//tools:gates2kg"],
)

# 투영 그래프 — 뷰(//defs:kb.bzl 의 VIEWS)·skill(tools/kb_lib.py 의 SKILLS)의 개체 (유저 답 Q9-a, 2026-10-03). 손으로 쓰지 않는다.
# 뷰·skill 은 층의 항목이 아니라 원본 도구의 `module` 코드 청크의 투영이다 — prov:wasDerivedFrom 이 그 청크를 가리키고
# agt:inLayer 를 갖지 않으므로 층별 집계(CQ-38)에 세어지지 않는다 (결정 p0-service-is-a-three-layer-wiki)
genrule(
    name = "projections_kg",
    srcs = ["//defs:kb.bzl"] + ["//tools:" + mod + ".chunks.yml" for mod in EXTRACTED_SOURCES],
    outs = ["projections-kg.ttl"],
    cmd = "$(location //tools:gates2kg) --projections --out $@ --gates $(location //defs:kb.bzl) --registry " +
          " ".join(["$(location //tools:%s.chunks.yml)" % mod for mod in EXTRACTED_SOURCES]),
    tools = ["//tools:gates2kg"],
)

# 참조 링크 — 본문의 인용에서 생성 (8.2절). 손으로 쓰지 않는다.
kb_reference_kg(
    name = "references_kg",
    srcs = [
        "//chunks",
        "//kb/dev",
        "//kb/vv",
    ],
    ontology = ["//kb/ontology:modules"],
    out = "references-kg.ttl",
)

# 지식그래프 게이트: 통제 어휘(4.4절) + 청크 shape + 가정→ODD 참조(0.4절) + 카탈로그 정합성(:kg 의 catalog-kg × //kb/odd:odd)
# + 설계 공간(//space:design_space 의 *-space) 의 규율 — 후보는 deps 가 아니므로 Bazel 이 로드 시점에 보지 못한다.
# 그 자리를 게이트 id `space`(validate check_space)가 대신한다 (결정 p9-candidate-storage, 요구 r-011)
kb_gate_test(
    name = "gate_test",
    data = [
        ":chunks_kg",
        ":gates_kg",
        ":kg",
        ":projections_kg",
        ":references_kg",
        "//space:design_space",
    ],
    # 게이트 element-drop 의 키 전수 대조 입력 — 청크 본문의 frontmatter 를 그래프가 아니라 파일로 읽는다.
    # 소비되지 않는 키는 head 그래프에 나타나지 않으므로 생성물만 보면 조용히 버려진 요소를 볼 수 없다 (현상 P19)
    chunk_files = [
        "//chunks",
        "//kb/dev",
        "//kb/vv",
        "//space",
    ],
    odd = ["//kb/odd:odd"],
    ontology = ["//kb/ontology:modules"],
    shapes = ["//kb/ontology:shapes"],
    standard_vocab = ["@prov_o//file", "@skos//file"],
    # size = "small" 의 기본 제한 60초에 실측 59~64초가 부딪혀 오늘 TIMEOUT 플레이크가 두 번 났다 — 판정 내용이 아니라
    # 예산이 문제이므로 검사를 줄이지 않고 제한만 300초로 올린다 (timeout 은 kb_gate_test 의 **kwargs 로 py_test 에 간다)
    timeout = "moderate",
    verify_queries = "//tools:verify_queries",
    # shape 는 약화하지 않고 면제만 선언한다 — 게이트 id `shacl`(축 `파일`). append-only 판정 로그의 토큰 상한
    # 초과처럼 소급 분할이 기록을 다시 쓰는 일인 자리가 그것이다 (docs/waivers.md, 2026-10-01)
    waivers = "//docs:waivers",
)

# 코어 지표 — 생성물 (bazel build //kg:metrics → bazel-bin/kg/metrics.md). 4.13절·14.1절
kb_cq_report(
    name = "cq",
    data = [
        ":chunks_kg",
        ":gates_kg",  # 층별 집계(CQ-38)의 분모 — 게이트는 프로세스 층의 항목이다
        ":kg",
        ":projections_kg",  # 뷰·skill 의 투영 — 층이 없으므로 CQ-38 의 집계는 바뀌지 않는다
        ":references_kg",
        "//kb/odd:odd",
        "//kb/ontology:modules",
    ],
    queries = "//tools:cq_queries",
)

kb_metrics(
    name = "metrics",
    bodies = ["//kb/dev"],
    data = [
        ":chunks_kg",
        ":kg",
        ":references_kg",
        "//kb/odd:odd",
        "//kb/ontology:modules",  # 연결 성분이 세 족의 하위 속성을 T-Box 에서 따라간다 (kb_lib.linkage_predicates)
    ],
    notes = "//docs:notes",
    spaces = ["//space:design_space"],  # 후보 링크는 연결로, 열린 공간의 후보 결정은 따로 센다 (유저 결정 Q60-a)
)

# 감사 보고서 (로드맵 8단계 "복원과 감사", 요구 audit-self-sufficiency) — 입력은 그래프 union 과 관측 청크(kb/vv/run/ 실행 기록 ·
# kb/dev/memory/ 가정 판정)뿐이다. 체계 밖 정보 0. bazel build //kg:audit → bazel-bin/kg/audit.md
kb_weave(
    name = "audit",
    bodies = [
        "//kb/vv",
        "//kb/dev",
    ],
    data = [
        ":chunks_kg",
        ":gates_kg",
        ":kg",
        ":references_kg",
        "//kb/odd:odd",
        "//kb/ontology:modules",
    ],
    kind = "audit",
)

# 커뮤니티 탐지 뷰 — 복합체 후보·relatedTo 링크 후보 (bazel build //kg:communities → bazel-bin/kg/communities.md). 채택은 사람
kb_community(
    name = "communities",
    data = [
        ":chunks_kg",
        ":kg",  # composite-kg 의 손으로 쓴 복합체 — 이미 복합체인 부분을 후보로 다시 내지 않기 위해
        ":references_kg",
    ],
)

# 복원 후보 생성기 뷰 (로드맵 8단계 복원) — frontmatter 링크가 없는 쌍의 후보를 체계 안 증거(cites · verifies 공동 커버 · usesConcept)로,
# 앵커당 k ≤ 7 (bazel build //kg:link_candidates → bazel-bin/kg/link-candidates.md). 확정은 사람이 앵커 청크의 restored: 로 — 게이트가 아니다
kb_link_candidates(
    name = "link_candidates",
    data = [
        ":chunks_kg",
        ":kg",  # composite-kg 의 손으로 쓴 복합체 — 형제끼리는 후보가 아니다
        ":references_kg",
    ],
)

# 작업 집합 뷰 — 선택자는 빌드 설정: bazel build //kg:workset --//kb:role=developer --//kb:anchor="두 KB" --//kb:levels=concrete
kb_workset_view(
    name = "workset",
    data = [
        ":chunks_kg",
        ":kg",
        ":references_kg",
        "//kb/dev",
        "//kb/vv",  # 앵커의 이웃에 V&V 항목이 있으면 본문을 펼친다 — 없으면 샌드박스에서 FileNotFoundError
    ],
)

# 미결 집계 뷰 — 설계 공간(`space/*-space.md`)과 청크의 선택 슬롯 `미확정:` 을 모은다 (p4-three-empty-values, Q54-a).
# 미결 목록의 유일한 자리이고 손 색인 docs/open-questions.md 를 대체한다(지시 0095). bazel build //kg:open → bazel-bin/kg/open.md
kb_open_questions(
    name = "open",
    bodies = [
        "//kb/dev",
        "//kb/vv",
    ],
    data = [":chunks_kg"],
    spaces = ["//space:design_space"],
)
