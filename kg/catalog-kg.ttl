# catalog-kg — 에이전트 카탈로그 (노트 9.2절 개발 프로파일의 부분집합).
# AGENTS.md의 역할 표와 이 그래프는 일치해야 한다 — 문서가 산문이고 여기가 형식이다.
# 역할이 규정하는 것은 plane 권한 요구까지다. 실제 절차는 AGENTS.md(하네스)의 몫이다.
@prefix agt: <https://agentic-knowledge-base.dev/agt/> .
@prefix id: <https://agentic-knowledge-base.dev/id/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

### 하네스

id:h-akb a agt:Harness ;
    rdfs:label "agentic-knowledge-base Bazel harness"@en , "agentic-knowledge-base Bazel 하네스"@ko ;
    agt:hasRole id:role-orchestrator , id:role-developer , id:role-vnv ,
        id:role-inspection , id:role-hci ;
    agt:grants id:scope-orchestrator , id:scope-developer , id:scope-vnv ,
        id:scope-inspection , id:scope-hci .

### 채널 — 유저 소통은 hci가 전담한다 (docs/feedback/README.md가 규약 원본)

id:chan-user-feedback a agt:Channel ;
    rdfs:label "user feedback channel"@en , "유저 피드백 채널"@ko ;
    agt:ownedBy id:role-hci ;
    prov:atLocation "docs/feedback" .

### 역할 — plane 권한 요구 (9.2절). 설계/구현/운영은 같은 write plane을 공유하지 않는다.

id:role-orchestrator a agt:Role ;
    rdfs:label "orchestrator"@en , "오케스트레이터"@ko ;
    agt:writes agt:DecisionChunk ;
    agt:reads agt:ContractChunk , agt:SchemaChunk , agt:ArtifactChunk , agt:AnnotationChunk , agt:MemoryChunk ;
    agt:executionMode agt:sessionPersistent ;
    agt:maxConcurrent 1 .

id:role-developer a agt:Role ;
    rdfs:label "developer"@en , "개발자"@ko ;
    agt:writes agt:ArtifactChunk ;
    agt:reads agt:ContractChunk , agt:SchemaChunk , agt:DecisionChunk ;
    agt:executionMode agt:dispatch ;
    agt:maxConcurrent 1 .

id:role-vnv a agt:Role ;
    rdfs:label "verification and validation"@en , "검증·확인"@ko ;
    agt:writes agt:AnnotationChunk ;
    agt:reads agt:ArtifactChunk , agt:DecisionChunk ;
    agt:executionMode agt:dispatch ;
    agt:maxConcurrent 1 .

id:role-inspection a agt:Role ;
    rdfs:label "inspection"@en , "조사"@ko ;
    agt:reads agt:DecisionChunk , agt:ContractChunk , agt:SchemaChunk , agt:ArtifactChunk , agt:AnnotationChunk , agt:MemoryChunk ;
    agt:executionMode agt:sessionPersistent ;
    agt:maxConcurrent 1 .

id:role-hci a agt:Role ;
    rdfs:label "human-computer interaction"@en , "유저 소통"@ko ;
    agt:reads agt:DecisionChunk , agt:ContractChunk , agt:SchemaChunk , agt:ArtifactChunk , agt:AnnotationChunk , agt:MemoryChunk ;
    agt:executionMode agt:sessionPersistent ;
    agt:maxConcurrent 1 .

### 스코프 — ODD 조건의 부분집합 + plane 권한 (0.4절, 3.4절)

id:scope-orchestrator a agt:Scope ;
    rdfs:label "orchestrator scope"@en , "오케스트레이터 스코프"@ko ;
    agt:mode "restrictive" ;
    agt:subsetOf id:odd-agentic-knowledge-base ;
    agt:includesCondition id:cond-build-system , id:cond-repo-layout ,
        id:cond-language-policy , id:cond-concurrent-agents ;
    agt:conditionalRule "include write plane artifact if 관련 decision 청크의 level = concrete (9.1절 '구현 전 상세 설계'의 기계적 강제)" .

id:scope-developer a agt:Scope ;
    rdfs:label "developer scope"@en , "개발자 스코프"@ko ;
    agt:mode "restrictive" ;
    agt:subsetOf id:odd-agentic-knowledge-base ;
    agt:includesCondition id:cond-build-system , id:cond-python-runtime ,
        id:cond-dependency-lock ;
    agt:excludesCondition id:cond-network .

id:scope-vnv a agt:Scope ;
    rdfs:label "verification and validation scope"@en , "검증·확인 스코프"@ko ;
    agt:mode "restrictive" ;
    agt:subsetOf id:odd-agentic-knowledge-base ;
    agt:includesCondition id:cond-build-system , id:cond-python-runtime ,
        id:cond-repo-layout ;
    agt:conditionalRule "판정만 한다 — 게이트 결과를 annotation 청크로 쓰되 판정 대상(artifact·decision)은 수정하지 않는다 (9.2절 저작·판정 분리)" .

id:scope-inspection a agt:Scope ;
    rdfs:label "inspection scope"@en , "조사 스코프"@ko ;
    agt:mode "restrictive" ;
    agt:subsetOf id:odd-agentic-knowledge-base ;
    agt:includesCondition id:cond-build-system , id:cond-repo-layout ,
        id:cond-concurrent-agents ;
    agt:conditionalRule "git 쓰기(add/commit/push)는 유저가 요청했고 bazel test //... 가 PASS일 때만" .

id:scope-hci a agt:Scope ;
    rdfs:label "human-computer interaction scope"@en , "유저 소통 스코프"@ko ;
    agt:mode "restrictive" ;
    agt:subsetOf id:odd-agentic-knowledge-base ;
    agt:includesCondition id:cond-language-policy , id:cond-repo-layout ,
        id:cond-concurrent-agents ;
    agt:conditionalRule "쓰기는 채널(docs/feedback/**)로 한정, 읽기는 저장소 전체. 지식 산출물 반영은 유저의 status: approved 태깅 뒤 담당 역할이 수행한다" .
