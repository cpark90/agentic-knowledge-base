"""agentic-knowledge-base — 에이전트 지식 관리 체계의 Bazel 하네스.

에이전트 지식 관리 체계를 인스턴스화한다 (체계의 규칙은 chunks/decision/).
- 지식 산출물(온톨로지·ODD·kg·청크)은 데이터 타깃이다
- 검사 게이트(6.7절)는 테스트 타깃이다 — `bazel test //...`가 게이트 전체다
- 참조 저장소(harness_ontology, harness-recipes)의 내용은 청크로 승격해
  가져온다(prov:wasDerivedFrom) — 프로젝트 자체에 대한 빌드 의존은 없다
"""

module(
    name = "agentic_knowledge_base",
    version = "0.1.0",
)

bazel_dep(name = "rules_python", version = "2.3.2")
bazel_dep(name = "bazel_skylib", version = "1.7.1")  # analysistest — 링크 방향·가시성 음성 시험

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.11",
    is_default = True,
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "kb_pip",
    python_version = "3.11",
    requirements_lock = "//tools:requirements_lock.txt",
)
use_repo(pip, "kb_pip")

# 외부 표준 어휘 원문 — 해시 고정 (bazel-dependency-review 기능 표 "module extension / repo rule (a)").
# 정의를 바꾸지 않고 그대로 쓰는 어휘(0.3절)이므로 원문은 빌드 입력이고, validate --standard-vocab 이
# 데이터·온톨로지가 쓴 prov:·skos: 용어가 원문에 실재하는지 본다. 타깃: @prov_o//file, @skos//file
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "prov_o",
    downloaded_file_path = "prov-o.ttl",
    sha256 = "7d203989f67b38bca572253942acc5a1bf24ce3ccfece16f072dcb4be2b79a96",
    urls = ["https://www.w3.org/ns/prov-o.ttl"],
)

http_file(
    name = "skos",
    downloaded_file_path = "skos.rdf",
    sha256 = "e79633b8d0564816cee8a99f5c9acf9a0e6fc7257c7209acd684ecad53a89dd6",
    urls = ["https://www.w3.org/2009/08/skos-reference/skos.rdf"],
)
